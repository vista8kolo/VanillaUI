    end
    return output
end

function WindowMethods:ClearActivities()
    for _, entry in ipairs(self.Activities or {}) do
        if entry.Object then
            destroy(entry.Object)
        end
    end
    table.clear(self.Activities)
    self.UnreadActivities = 0
    if type(self._refreshActivityEmpty) == "function" then
        self:_refreshActivityEmpty()
    end
    if type(self._refreshActivityBadge) == "function" then
        self:_refreshActivityBadge()
    end
    return self
end

