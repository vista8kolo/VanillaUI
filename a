    local hasDescription = description ~= ""
    local iconLabel = createElementIcon(parent, icon, 10, 10)
    local left = iconLabel and 34 or 10

    local titleLabel = create("TextLabel", {
        Name = "Title",
        Position = UDim2.fromOffset(left, 6),
        Size = UDim2.new(1, -(left + rightWidth), 0, 22),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = tostring(title),
        TextColor3 = THEME.Text,
        TextSize = DEFAULT_TEXT_SIZE,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
        TextTruncate = Enum.TextTruncate.None,
        ZIndex = 3,
    }, parent)

    local descriptionLabel
    if hasDescription then
        descriptionLabel = create("TextLabel", {
            Name = "Description",
            Position = UDim2.fromOffset(left, 31),
            Size = UDim2.new(1, -(left + rightWidth), 0, 26),
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            Text = description,
            TextColor3 = THEME.SubText,
            TextSize = DEFAULT_DESCRIPTION_SIZE,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            TextTruncate = Enum.TextTruncate.None,
            LineHeight = 1.05,
            ZIndex = 3,
        }, parent)
    end

    local lastWidth = 0
    local relayoutQueued = false

    local function relayout()
        if not parent or not parent.Parent then
            return minimumHeight
        end

        local width = estimateControlWidth(window, parent)
        local usableWidth = math.max(48, width - left - rightWidth)
        local titleHeight = measureWrappedHeight(
            titleLabel.Text,
            Enum.Font.GothamMedium,
            titleLabel.TextSize,
            usableWidth,
            MAX_TITLE_LINES
        )
        local descriptionShown = descriptionLabel and descriptionLabel.Visible
        local descriptionHeight = descriptionShown and measureWrappedHeight(
            descriptionLabel.Text,
            Enum.Font.Gotham,
            descriptionLabel.TextSize,
            usableWidth,
            MAX_DESCRIPTION_LINES
        ) or 0

        local contentHeight
        local titleY
        if descriptionShown then
            titleY = 6
            contentHeight = 6 + titleHeight + 3 + descriptionHeight + 7
        else
            contentHeight = math.max(minimumHeight - bottomReserve, titleHeight + 12)
            titleY = math.floor((contentHeight - titleHeight) / 2)
        end

        local totalHeight = math.max(minimumHeight, contentHeight + bottomReserve)
        parent.Size = UDim2.new(parent.Size.X.Scale, parent.Size.X.Offset, 0, totalHeight)

        titleLabel.Position = UDim2.fromOffset(left, titleY)
        titleLabel.Size = UDim2.new(1, -(left + rightWidth), 0, titleHeight)

        if descriptionLabel then
            descriptionLabel.Position = UDim2.fromOffset(left, titleY + titleHeight + 3)
            descriptionLabel.Size = UDim2.new(1, -(left + rightWidth), 0, descriptionShown and descriptionHeight or 0)
        end

        if iconLabel then
            iconLabel.Position = UDim2.fromOffset(10, titleY + math.max(0, math.floor((titleHeight - 16) / 2)))
        end

        if type(onHeightChanged) == "function" then
            safeCall(onHeightChanged, totalHeight, contentHeight)
        end

        return totalHeight
    end

    local function queueRelayout()
        if relayoutQueued then
            return
        end
        relayoutQueued = true
        task.defer(function()
            relayoutQueued = false
            relayout()
        end)
    end

    if window then
        registerConnection(window, titleLabel:GetPropertyChangedSignal("Text"):Connect(queueRelayout))
        if descriptionLabel then
            registerConnection(window, descriptionLabel:GetPropertyChangedSignal("Text"):Connect(queueRelayout))
        end
        registerConnection(window, parent:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local width = math.floor(parent.AbsoluteSize.X + 0.5)
            if width ~= lastWidth then
                lastWidth = width
                queueRelayout()
            end
        end))
    end

    local resolvedHeight = relayout()
    return titleLabel, descriptionLabel, iconLabel, resolvedHeight, relayout
end

local function styleInteractiveSurface(window, object, interact, activeProvider, textObjects)
    styleSurface(object, THEME.Button)
    local stroke = object:FindFirstChildOfClass("UIStroke")
    local hovered = false
    local textStates = {}

    for _, textObject in ipairs(textObjects or {}) do
        if textObject then
            textStates[textObject] = {
                Normal = textObject.TextColor3,
                Secondary = textObject.TextColor3 == THEME.SubText,
            }
        end
    end

    local function refresh(forcedHovered)
        if forcedHovered ~= nil then
            hovered = forcedHovered == true
        end
        local active = type(activeProvider) == "function" and activeProvider() == true
        local locked = object:GetAttribute("VanillaUILocked") == true
        local background = locked and THEME.Disabled or (active and THEME.Accent or (hovered and THEME.Hover or THEME.Button))
        local transparency = locked and 0.12 or (active and STYLE.AcrylicActive or (hovered and STYLE.AcrylicHover or STYLE.Acrylic))
        tween(object, {BackgroundColor3 = background, BackgroundTransparency = transparency})
        if stroke then
            tween(stroke, {Transparency = active and STYLE.StrokeActive or (hovered and STYLE.StrokeHover or STYLE.Stroke)})
        end
        for textObject, state in pairs(textStates) do
            if textObject and textObject.Parent then
                local textColor
                if locked then
                    textColor = THEME.DisabledText
                elseif active then
                    textColor = state.Secondary and THEME.ActiveSubText or THEME.ActiveText
                elseif hovered then
                    textColor = state.Secondary and THEME.SubText or THEME.CategoryTitle
                else
                    textColor = state.Normal
                end
                tween(textObject, {TextColor3 = textColor})
            end
        end
    end

    registerConnection(window, interact.MouseEnter:Connect(function()
        hovered = true
        window:_playSound("Hover")
        refresh()
    end))
    registerConnection(window, interact.MouseButton1Down:Connect(function()
        if object:GetAttribute("VanillaUILocked") ~= true then
            window:_playSound("Click")
        end
    end))
    registerConnection(window, interact.MouseLeave:Connect(function()
        hovered = false
        refresh()
    end))
    refresh()
    return refresh
end

