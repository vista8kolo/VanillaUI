function WindowMethods:SetSoundProfile(profile)
    if profile == false then
        self.SoundProfile = mergeInto(DEFAULT_SOUND_PROFILE, {Enabled = false})
        return self
    end
    self.SoundProfile = mergeInto(self.SoundProfile or DEFAULT_SOUND_PROFILE, profile)
    if type(profile) == "table" and profile.Enabled == nil then
        for _, key in ipairs({"Hover", "Click", "Enable", "Disable", "Error", "Confirm", "Open", "Close", "Notification", "Tab"}) do
            if resolveSoundAsset(profile[key]) then
                self.SoundProfile.Enabled = true
                break
            end
        end
    end
    return self
end

function WindowMethods:_playSound(eventName, overrides)
    local profile = self.SoundProfile or DEFAULT_SOUND_PROFILE
    if profile.Enabled == false then
        return nil
    end

    local definition = overrides or profile[eventName]
    local soundId = resolveSoundAsset(definition)
    if not soundId then
        return nil
    end

    if eventName == "Hover" then
        local now = os.clock()
        local interval = math.max(0, tonumber(profile.HoverInterval) or 0.08)
        if now - (self._lastHoverSoundAt or 0) < interval then
            return nil
        end
        self._lastHoverSoundAt = now
    end

    self._sounds = self._sounds or {}
    local sound = self._sounds[eventName]
    if not sound or not sound.Parent then
        sound = create("Sound", {
            Name = "VanillaUI_" .. tostring(eventName),
            RollOffMaxDistance = 40,
        }, SoundService)
        self._sounds[eventName] = sound
    end

    local localVolume = type(definition) == "table" and tonumber(definition.Volume) or nil
    local localSpeed = type(definition) == "table" and tonumber(definition.Speed or definition.PlaybackSpeed) or nil
    local variation = math.max(0, tonumber(profile.PitchVariation) or 0)
    local randomOffset = variation > 0 and ((math.random() * 2 - 1) * variation) or 0

    sound.SoundId = soundId
    sound.Volume = math.clamp(localVolume or tonumber(profile.Volume) or 0.25, 0, 10)
    sound.PlaybackSpeed = math.max(0.05, (localSpeed or 1) * (1 + randomOffset))
    sound.TimePosition = 0
    pcall(function()
        sound:Play()
    end)
    return sound
end

