function TagMethods:Set(options)
    options = type(options) == "table" and options or {text = options}
    if options.color ~= nil or options.Color ~= nil then self:SetColor(options.color or options.Color) end
    if options.text ~= nil or options.Text ~= nil or options.title ~= nil or options.Title ~= nil then
        self:SetText(options.text or options.Text or options.title or options.Title)
    end
    if options.icon ~= nil or options.Icon ~= nil then self:SetIcon(options.icon or options.Icon) end
    return self
end

function TagMethods:Remove()
