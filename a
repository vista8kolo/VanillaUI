function ElementMethods:SetVisible(visible)
    self.Visible = visible ~= false
    if self.Object then
        self.Object.Visible = self.Visible
    end
    if self.Window and type(self.Window._refreshSearchResults) == "function" then
        task.defer(self.Window._refreshSearchResults)
    end
    return self
end

function ElementMethods:SetTitle(title)
    self.Title = tostring(title or "")
    self.name = self.Title
    self.Name = self.Title
    if self.TitleLabel then
        self.TitleLabel.Text = self.Title
    elseif self.Object and self.Object:IsA("TextButton") then
        self.Object.Text = self.Title
    end
    if self.Window then
        self.Window:_refreshElementSearchText(self)
    end
    return self
end

ElementMethods.SetName = ElementMethods.SetTitle

function ElementMethods:SetDescription(description)
    self.Description = tostring(description or "")
    self.description = self.Description
    if self.DescriptionLabel then
        self.DescriptionLabel.Text = self.Description
        self.DescriptionLabel.Visible = self.Description ~= ""
    end
    if self.Window then
        self.Window:_refreshElementSearchText(self)
    end
    return self
end

function ElementMethods:Lock(reason)
    self.Locked = true
    self.LockReason = reason
    if self.Object then
        self.Object:SetAttribute("VanillaUILocked", true)
        self.Object.BackgroundColor3 = THEME.Disabled
    end
    local refresh = self._refreshVisual or self.Refresh
    if refresh then
        refresh(self)
    end
    return self
end

function ElementMethods:Unlock()
    self.Locked = false
    self.LockReason = nil
    if self.Object then
        self.Object:SetAttribute("VanillaUILocked", nil)
    end
    local refresh = self._refreshVisual or self.Refresh
    if refresh then
        refresh(self)
    end
    return self
end

function ElementMethods:MoveTo(index)
    if self.Section and type(self.Section._moveElement) == "function" then
        self.Section:_moveElement(self, index)
    end
    return self
end

function ElementMethods:MoveToTop()
    return self:MoveTo(1)
end

function ElementMethods:MoveToBottom()
    return self:MoveTo(self.Section and #self.Section.Elements or 1)
end

function ElementMethods:MoveUp()
    if self.Section then
        local index = table.find(self.Section.Elements, self)
        if index then
            self:MoveTo(index - 1)
        end
    end
    return self
end

function ElementMethods:MoveDown()
    if self.Section then
        local index = table.find(self.Section.Elements, self)
        if index then
            self:MoveTo(index + 1)
        end
    end
    return self
end

function ElementMethods:Destroy()
    if self.Window then
        self.Window._elements[self] = nil
        if self.Flag and self.Window._flagElements[self.Flag] == self then
            self.Window._flagElements[self.Flag] = nil
            self.Window.Flags[self.Flag] = nil
            VanillaUI.Flags[self.Flag] = nil
        end
    end
    if self.Section and self.Section.Elements then
        local index = table.find(self.Section.Elements, self)
        if index then
            table.remove(self.Section.Elements, index)
            if type(self.Section._reflowElements) == "function" then
                self.Section:_reflowElements()
            end
        end
    end
    if self.Window and self.Window._keybinds then
        self.Window._keybinds[self] = nil
    end
    destroy(self.Object)
end

ElementMethods.Remove = ElementMethods.Destroy

local function registerConnection(window, connection)
    window._connections[#window._connections + 1] = connection
    return connection
end

local function mirrorValueFields(element, value)
    element.value = value
    element.Value = value
    element.CurrentValue = value
    if element.Type == "Dropdown" then
        element.CurrentOption = value
    elseif element.Type == "Keybind" then
        element.CurrentKeybind = value
    elseif element.Type == "ColorPicker" then
        element.Color = value
    end
end

local function registerElement(section, element, searchableObject)
    local window = section.Window
    element.Window = window
    element.Section = section
    element.Tab = section.Tab
    element.Object = element.Object or searchableObject
    element.Title = element.Title or element.name or ""
    element.Name = element.Title
    element.name = element.Title
    element.Description = element.Description or element.description or ""
    element.description = element.Description
    element.Visible = true
    element.ForgetState = element.ForgetState == true or element.forgetState == true
    element.forgetState = element.ForgetState

    if element.Stateful and not element.ForgetState then
        local requestedFlag = element.Flag or element.flag
        element.Flag = window:_uniqueFlag(requestedFlag or deriveFlagFromName(element.Title), element)
        element.flag = element.Flag
    else
        element.Flag = element.Flag or element.flag
        element.flag = element.Flag
    end

    window._elements[element] = true
    section.Elements = section.Elements or {}
    section.Elements[#section.Elements + 1] = element

    if searchableObject then
        searchableObject:SetAttribute("VanillaUISearchable", true)
    end
    window:_refreshElementSearchText(element)

    if element.Stateful then
        mirrorValueFields(element, element.value ~= nil and element.value or element.Value)
    end

    if element.Flag then
        window._flagElements[element.Flag] = element
        window.Flags[element.Flag] = element.value
        VanillaUI.Flags[element.Flag] = element.value
        if window._loadedValues[element.Flag] ~= nil and type(element.Set) == "function" then
            local restored = deserializeValue(window._loadedValues[element.Flag])
            task.defer(function()
                if not window.Destroyed and element.Object and element.Object.Parent then
                    element:Set(restored, false, true)
                end
            end)
        end
    end

    if type(section._refreshGroupSize) == "function" then
        task.defer(section._refreshGroupSize, section)
    end
    if type(window._refreshSearchResults) == "function" then
        task.defer(window._refreshSearchResults)
    end

    return element
end

local function updateFlag(element, value, skipSave)
    mirrorValueFields(element, value)
    if element.Flag then
        element.Window.Flags[element.Flag] = value
        VanillaUI.Flags[element.Flag] = value
    end
    if not skipSave and not element.ForgetState then
        element.Window:_scheduleSave()
    end
end

local function styleButton(window, button, isActiveProvider)
    button.AutoButtonColor = false
    button.Font = Enum.Font.Gotham
    button.TextSize = 12
    button.TextWrapped = true
    button.TextScaled = false
    button.TextColor3 = THEME.Text
    styleSurface(button, THEME.Button)

    local stroke = button:FindFirstChildOfClass("UIStroke")

    local function refresh(hovered)
        local active = type(isActiveProvider) == "function" and isActiveProvider() == true
        local background = active and THEME.Accent or (hovered and THEME.Hover or THEME.Button)
        local textColor = active and Color3.fromRGB(20, 19, 17) or (hovered and THEME.SubText or THEME.Text)
        local transparency = active and STYLE.AcrylicActive or (hovered and STYLE.AcrylicHover or STYLE.Acrylic)
        local strokeTransparency = active and STYLE.StrokeActive or (hovered and STYLE.StrokeHover or STYLE.Stroke)

        tween(button, {
            BackgroundColor3 = background,
            BackgroundTransparency = transparency,
            TextColor3 = textColor,
        })

        if stroke then
            tween(stroke, {
                Transparency = strokeTransparency,
                Thickness = hovered and 1.25 or 1,
            })
        end
    end

    registerConnection(window, button.MouseEnter:Connect(function()
        if not button:GetAttribute("VanillaUILocked") then
            refresh(true)
        end
    end))

    registerConnection(window, button.MouseLeave:Connect(function()
        if not button:GetAttribute("VanillaUILocked") then
            refresh(false)
        end
    end))

    refresh(false)
    return refresh
end

local function createElementIcon(parent, icon, x, y)
    local resolved = resolveIcon(icon)
    if not resolved then
        return nil
    end
    return create("ImageLabel", {
        Name = "Icon",
        Position = UDim2.fromOffset(x or 10, y or 9),
        Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Image = resolved,
        ImageColor3 = THEME.SubText,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 3,
    }, parent)
end

local function createElementHeader(parent, options, rightWidth, forcedHeight)
    options = options or {}
    local title = option(options, {"name", "Name", "title", "Title"}, "Control")
    local description = tostring(option(options, {"description", "Description"}, "") or "")
    local icon = option(options, {"icon", "Icon"}, nil)
    local hasDescription = description ~= ""
    local height = forcedHeight or (hasDescription and 52 or 34)
    local iconLabel = createElementIcon(parent, icon, 10, math.floor((height - 16) / 2))
    local left = iconLabel and 34 or 10
    local titleY = hasDescription and 7 or 0
    local titleHeight = hasDescription and 17 or height

    local titleLabel = create("TextLabel", {
        Name = "Title",
        Position = UDim2.fromOffset(left, titleY),
        Size = UDim2.new(1, -(left + (rightWidth or 10)), 0, titleHeight),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = tostring(title),
        TextColor3 = THEME.Text,
        TextSize = DEFAULT_TEXT_SIZE,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 3,
    }, parent)

    local descriptionLabel
    if hasDescription then
        descriptionLabel = create("TextLabel", {
            Name = "Description",
            Position = UDim2.fromOffset(left, 25),
            Size = UDim2.new(1, -(left + (rightWidth or 10)), 0, height - 29),
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            Text = description,
            TextColor3 = THEME.SubText,
            TextSize = DEFAULT_DESCRIPTION_SIZE,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 3,
        }, parent)
    end

    return titleLabel, descriptionLabel, iconLabel, height
end

local function styleInteractiveSurface(window, object, interact, activeProvider, textObjects)
    styleSurface(object, THEME.Button)
    local stroke = object:FindFirstChildOfClass("UIStroke")
    local hovered = false

    local function refresh()
        local active = type(activeProvider) == "function" and activeProvider() == true
        local locked = object:GetAttribute("VanillaUILocked") == true
        local background = locked and THEME.Disabled or (active and THEME.Accent or (hovered and THEME.Hover or THEME.Button))
        local textColor = locked and THEME.DisabledText or (active and Color3.fromRGB(20, 19, 17) or (hovered and THEME.CategoryTitle or THEME.Text))
        local transparency = locked and 0.12 or (active and STYLE.AcrylicActive or (hovered and STYLE.AcrylicHover or STYLE.Acrylic))
        tween(object, {BackgroundColor3 = background, BackgroundTransparency = transparency})
        if stroke then
            tween(stroke, {Transparency = active and STYLE.StrokeActive or (hovered and STYLE.StrokeHover or STYLE.Stroke)})
        end
        for _, textObject in ipairs(textObjects or {}) do
            if textObject and textObject.Parent then
                tween(textObject, {TextColor3 = textColor})
            end
        end
    end

    registerConnection(window, interact.MouseEnter:Connect(function()
        hovered = true
        refresh()
    end))
    registerConnection(window, interact.MouseLeave:Connect(function()
        hovered = false
        refresh()
    end))
    refresh()
    return refresh
end

local function createSectionTitle(section, title)
    local label = create("TextLabel", {
        Name = "SectionTitle",
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = string.upper(title),
        TextColor3 = THEME.SubText,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = section:_nextOrder(),
    }, section.Parent)

    local divider = create("Frame", {
        Name = "SectionDivider",
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = THEME.Accent,
        BackgroundTransparency = 0.58,
        BorderSizePixel = 0,
        LayoutOrder = section:_nextOrder(),
    }, section.Parent)

    section.TitleLabel = label
    section.Divider = divider
end

function SectionMethods:_nextOrder()
    self.Window._layoutOrder = self.Window._layoutOrder + 1
    return self.Window._layoutOrder
end

function SectionMethods:_reflowElements()
    local orders = {}
    for _, element in ipairs(self.Elements or {}) do
        if element.Object and element.Object.Parent then
            orders[#orders + 1] = element.Object.LayoutOrder
        end
    end
    table.sort(orders)
    for index, element in ipairs(self.Elements or {}) do
        if element.Object and element.Object.Parent then
            element.Object.LayoutOrder = orders[index] or self:_nextOrder()
        end
    end
    if type(self._refreshGroupSize) == "function" then
        self:_refreshGroupSize()
    end
end

function SectionMethods:_moveElement(element, index)
    self.Elements = self.Elements or {}
    local current = table.find(self.Elements, element)
    if not current then
        return
    end
    table.remove(self.Elements, current)
    index = math.clamp(math.floor(tonumber(index) or 1), 1, #self.Elements + 1)
    table.insert(self.Elements, index, element)
    self:_reflowElements()
end

function SectionMethods:CreateButton(options)
    options = type(options) == "table" and options or {name = tostring(options)}
    local title = tostring(option(options, {"name", "Name", "title", "Title"}, "Button"))
    local description = tostring(option(options, {"description", "Description"}, "") or "")
    local height = description ~= "" and 52 or 34

    local button = create("TextButton", {
        Name = "Button",
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = self:_nextOrder(),
        Text = "",
        AutoButtonColor = false,
    }, self.Parent)
    local titleLabel, descriptionLabel, iconLabel = createElementHeader(button, options, 12, height)

    local element = setmetatable({
        Type = "Button",
        Title = title,
        Description = description,
        Object = button,
        TitleLabel = titleLabel,
        DescriptionLabel = descriptionLabel,
        IconLabel = iconLabel,
        Callback = option(options, {"callback", "Callback"}, nil),
        ForgetState = true,
    }, ElementMethods)

    local refreshStyle = styleInteractiveSurface(self.Window, button, button, nil, {titleLabel, descriptionLabel})
    element.Refresh = refreshStyle

    local function run()
        if element.Locked then
            self.Window:Notify({Title = "Control bloqueado", Content = element.LockReason or title, Duration = 3})
            return
        end
        tween(button, {BackgroundTransparency = 0})
        safeCall(element.Callback)
        task.delay(0.09, refreshStyle)
    end

    registerConnection(self.Window, button.MouseButton1Click:Connect(run))

    function element:Press()
        run()
        return self
    end

    function element:Set(value)
        if type(value) == "table" then
            if value.name ~= nil or value.Name ~= nil or value.title ~= nil or value.Title ~= nil then
                self:SetTitle(option(value, {"name", "Name", "title", "Title"}, self.Title))
            end
            if value.description ~= nil or value.Description ~= nil then
                self:SetDescription(option(value, {"description", "Description"}, ""))
            end
            if value.callback ~= nil or value.Callback ~= nil then
                self.Callback = option(value, {"callback", "Callback"}, self.Callback)
            end
        else
            self:SetTitle(value)
        end
        return self
    end

    return registerElement(self, element, button)
end

