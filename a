function WindowMethods:Notify(options)
    options = type(options) == "table" and options or {content = tostring(options)}
    local sourceTitle = tostring(option(options, {"title", "Title"}, "VanillaUI"))
    local sourceContent = tostring(option(options, {"content", "Content", "description", "Description"}, ""))
    local title = self:_translate(sourceTitle)
    local content = self:_translate(sourceContent)
    local duration = math.max(0.5, tonumber(option(options, {"duration", "Duration"}, 4)) or 4) + NOTIFICATION_EXTRA_DURATION
    local onClick = option(options, {"onClick", "OnClick", "callback", "Callback"}, nil)
    local state = tostring(option(options, {"state", "State", "type", "Type"}, "Information"))
    local normalizedState = string.lower(state)
    local stateColor = THEME.Accent
    if normalizedState == "success" or normalizedState == "confirm" then
        stateColor = Color3.fromRGB(104, 190, 126)
    elseif normalizedState == "warning" then
        stateColor = Color3.fromRGB(225, 170, 72)
    elseif normalizedState == "error" or normalizedState == "danger" then
        stateColor = Color3.fromRGB(220, 92, 92)
    end

    local wrapper = create("Frame", {
        Name = "NotificationWrapper",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        LayoutOrder = self._notificationOrder,
        ZIndex = 201,
    }, self.NotificationHolder)
    self._notificationOrder = self._notificationOrder + 1

    local card = create("Frame", {
        Name = "Notification",
        Position = UDim2.fromOffset(36, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ZIndex = 202,
    }, wrapper)
    styleSurface(card, THEME.Background, STYLE.MainCorner)
    card.BackgroundTransparency = 1
    local stroke = card:FindFirstChildOfClass("UIStroke")
    if stroke then stroke.Transparency = 1 end

    create("UIPadding", {
        PaddingTop = UDim.new(0, 11),
        PaddingBottom = UDim.new(0, 13),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
    }, card)
    create("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, card)

    local titleLabel = create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = THEME.Text,
        TextTransparency = 1,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
        ZIndex = 203,
    }, card)
    local contentLabel = create("TextLabel", {
        Name = "Content",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = content,
        TextColor3 = THEME.SubText,
        TextTransparency = 1,
        TextSize = 13,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 2,
        ZIndex = 203,
    }, card)
    local titleBinding = self:_bindLocalized(titleLabel, "Text", function() return sourceTitle end)
    local contentBinding = self:_bindLocalized(contentLabel, "Text", function() return sourceContent end)

    local progressTrack = create("Frame", {
        Name = "ProgressTrack",
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Color3.fromRGB(40, 37, 32),
        BorderSizePixel = 0,
        LayoutOrder = 3,
        ZIndex = 203,
    }, card)
    addCorner(progressTrack, 1)
    local progress = create("Frame", {
        Name = "Progress",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = stateColor,
        BorderSizePixel = 0,
        ZIndex = 204,
    }, progressTrack)
    addCorner(progress, 1)

    local interact
    if type(onClick) == "function" then
        interact = create("TextButton", {
            Name = "Interact",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 205,
        }, card)
    end

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(card, {Position = UDim2.fromOffset(42, 0), BackgroundTransparency = 1})
        tween(titleLabel, {TextTransparency = 1})
        tween(contentLabel, {TextTransparency = 1})
        if stroke then tween(stroke, {Transparency = 1}) end
        task.delay(0.22, function() destroy(wrapper) end)
    end

    if interact then
        registerConnection(self, interact.MouseButton1Click:Connect(function()
            safeCall(onClick)
            close()
        end))
    end

    if option(options, {"logActivity", "LogActivity"}, true) ~= false then
        self:LogActivity({Title = sourceTitle, Content = sourceContent, State = state})
    end
    if normalizedState == "error" or normalizedState == "danger" then
        self:_playSound("Error")
    elseif normalizedState == "success" or normalizedState == "confirm" then
        self:_playSound("Confirm")
    else
        self:_playSound("Notification")
    end

    task.defer(function()
        if not card.Parent then return end
        tween(card, {Position = UDim2.fromOffset(0, 0), BackgroundTransparency = STYLE.Acrylic})
        tween(titleLabel, {TextTransparency = 0})
        tween(contentLabel, {TextTransparency = 0})
        if stroke then tween(stroke, {Transparency = STYLE.Stroke}) end
        local progressTween = TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)})
        progressTween:Play()
    end)
    task.delay(duration, close)

    return {
        Object = wrapper,
        Close = close,
        SetTitle = function(_, value)
            sourceTitle = tostring(value or "")
            self:_applyTranslationBinding(titleBinding)
        end,
        SetContent = function(_, value)
            sourceContent = tostring(value or "")
            self:_applyTranslationBinding(contentBinding)
        end,
    }
end

