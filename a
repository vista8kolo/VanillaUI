local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local CurrentCamera = Workspace.CurrentCamera

local THEME = {
    Accent = Color3.fromRGB(208, 193, 162),
    CategoryTitle = Color3.fromRGB(228, 218, 198),
    Background = Color3.fromRGB(10, 10, 10),
    Button = Color3.fromRGB(26, 24, 20),
    ButtonAlt = Color3.fromRGB(20, 19, 17),
    Hover = Color3.fromRGB(33, 30, 25),
    Border = Color3.fromRGB(8, 8, 8),
    Text = Color3.fromRGB(228, 218, 198),
    SubText = Color3.fromRGB(195, 185, 165),
    Disabled = Color3.fromRGB(72, 24, 32),
    DisabledText = Color3.fromRGB(226, 194, 198),
}

local STYLE = {
    Corner = 5,
    MainCorner = 7,
    Acrylic = 0.10,
    AcrylicHover = 0.035,
    AcrylicActive = 0.015,
    Stroke = 0.20,
    StrokeHover = 0.08,
    StrokeActive = 0.10,
    Tween = TweenInfo.new(0.14, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
}

local GLOBAL_ENV = _G
pcall(function()
    if type(getgenv) == "function" then
        GLOBAL_ENV = getgenv()
    end
end)

local CLEANUP_KEY = "__VANILLA_UI_ACTIVE"
if type(GLOBAL_ENV[CLEANUP_KEY]) == "function" then
    pcall(GLOBAL_ENV[CLEANUP_KEY])
end
GLOBAL_ENV[CLEANUP_KEY] = nil

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return true
    end

    local ok, result = pcall(callback, ...)
    if not ok then
        warn("[VanillaUI] Callback error: " .. tostring(result))
    end
    return ok, result
end

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function destroy(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

local function create(className, properties, parent)
    local instance = Instance.new(className)
    for property, value in pairs(properties or {}) do
        instance[property] = value
    end
    instance.Parent = parent
    return instance
end

local function addCorner(object, radius)
    local corner = object:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or STYLE.Corner)
    corner.Parent = object
    return corner
end

local function addStroke(object, color, transparency)
    local stroke = object:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or THEME.Border
    stroke.Thickness = 1
    stroke.Transparency = transparency == nil and STYLE.Stroke or transparency
    stroke.Parent = object
    return stroke
end

local function styleSurface(object, background, radius)
    object.BackgroundColor3 = background or THEME.Button
    object.BackgroundTransparency = STYLE.Acrylic
    object.BorderSizePixel = 0
    object.ClipsDescendants = true
    addCorner(object, radius)
    addStroke(object, THEME.Border, STYLE.Stroke)
end

local function tween(object, properties)
    local animation = TweenService:Create(object, STYLE.Tween, properties)
    animation:Play()
    return animation
end

local function normalizeKey(value, fallback)
    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
        return value
    end
    if type(value) == "string" and Enum.KeyCode[value] then
        return Enum.KeyCode[value]
    end
    return fallback or Enum.KeyCode.Delete
end

local function normalizeTitle(options, fallback)
    if type(options) == "string" then
        return options
    end
    if type(options) == "table" then
        return options.Title or options.Name or fallback
    end
    return fallback
end

local function resolveGuiParent()
    local parent

    pcall(function()
        if type(gethui) == "function" then
            parent = gethui()
        end
    end)

    if parent then
        return parent
    end

    if LocalPlayer then
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
        if playerGui then
            return playerGui
        end
    end

    return CoreGui
end

local function sanitizeFileName(value)
    value = tostring(value or "VanillaUI")
    value = value:gsub("[^%w%-%_ ]", "")
    value = value:gsub("%s+", "_")
    if value == "" then
        value = "VanillaUI"
    end
    return value
end

local function serializeValue(value)
    local valueType = typeof(value)
    if valueType == "boolean" or valueType == "number" or valueType == "string" then
        return value
    end
    if valueType == "EnumItem" then
        return tostring(value)
    end
    if valueType == "table" then
        local output = {}
        for key, item in pairs(value) do
            local serialized = serializeValue(item)
            if serialized ~= nil then
                output[key] = serialized
            end
        end
        return output
    end
    return nil
end

local WindowMethods = {}
WindowMethods.__index = WindowMethods

local TabMethods = {}
TabMethods.__index = TabMethods

local SectionMethods = {}
SectionMethods.__index = SectionMethods

local ElementMethods = {}
ElementMethods.__index = ElementMethods

function ElementMethods:SetVisible(visible)
    self.Visible = visible ~= false
    if self.Object then
        self.Object.Visible = self.Visible
    end
    return self
end

function ElementMethods:SetTitle(title)
    self.Title = tostring(title or "")
    if self.TitleLabel then
        self.TitleLabel.Text = self.Title
    elseif self.Object and self.Object:IsA("TextButton") then
        self.Object.Text = self.Title
    end
    return self
end

function ElementMethods:Lock(reason)
    self.Locked = true
    self.LockReason = reason
    if self.Object then
        self.Object:SetAttribute("VanillaUILocked", true)
        self.Object.BackgroundColor3 = THEME.Disabled
        if self.Object:IsA("TextButton") then
            self.Object.TextColor3 = THEME.DisabledText
        end
    end
    return self
end

function ElementMethods:Unlock()
    self.Locked = false
    self.LockReason = nil
    if self.Object then
        self.Object:SetAttribute("VanillaUILocked", nil)
    end
    if self.Refresh then
        self:Refresh()
    end
    return self
end

function ElementMethods:Destroy()
    if self.Window then
        self.Window._elements[self] = nil
        if self.Flag and self.Window._flagElements[self.Flag] == self then
            self.Window._flagElements[self.Flag] = nil
            self.Window.Flags[self.Flag] = nil
            VanillaUI.Flags[self.Flag] = nil
        end
    end
    destroy(self.Object)
end

local function registerConnection(window, connection)
    window._connections[#window._connections + 1] = connection
    return connection
end

local function registerElement(section, element, searchableObject)
    local window = section.Window
    element.Window = window
    element.Section = section
    element.Object = element.Object or searchableObject
    element.Title = element.Title or ""
    element.Visible = true
    window._elements[element] = true

    if searchableObject then
        searchableObject:SetAttribute("VanillaUISearchText", string.lower(element.Title))
    end

    if element.Flag then
        window._flagElements[element.Flag] = element
        window.Flags[element.Flag] = element.Value
        VanillaUI.Flags[element.Flag] = element.Value
    end

    return element
end

local function updateFlag(element, value, skipSave)
    element.Value = value
    if element.Flag then
        element.Window.Flags[element.Flag] = value
        VanillaUI.Flags[element.Flag] = value
    end
    if not skipSave then
        element.Window:_scheduleSave()
    end
end

local function styleButton(window, button, isActiveProvider)
    button.AutoButtonColor = false
    button.Font = Enum.Font.Gotham
    button.TextSize = 12
    button.TextWrapped = true
    button.TextScaled = false
    button.TextColor3 = THEME.Text
    styleSurface(button, THEME.Button)

    local stroke = button:FindFirstChildOfClass("UIStroke")

    local function refresh(hovered)
        local active = type(isActiveProvider) == "function" and isActiveProvider() == true
        local background = active and THEME.Accent or (hovered and THEME.Hover or THEME.Button)
        local textColor = active and Color3.fromRGB(20, 19, 17) or (hovered and THEME.SubText or THEME.Text)
        local transparency = active and STYLE.AcrylicActive or (hovered and STYLE.AcrylicHover or STYLE.Acrylic)
        local strokeTransparency = active and STYLE.StrokeActive or (hovered and STYLE.StrokeHover or STYLE.Stroke)

        tween(button, {
            BackgroundColor3 = background,
            BackgroundTransparency = transparency,
            TextColor3 = textColor,
        })

        if stroke then
            tween(stroke, {
                Transparency = strokeTransparency,
                Thickness = hovered and 1.25 or 1,
            })
        end
    end

    registerConnection(window, button.MouseEnter:Connect(function()
        if not button:GetAttribute("VanillaUILocked") then
            refresh(true)
        end
    end))

    registerConnection(window, button.MouseLeave:Connect(function()
        if not button:GetAttribute("VanillaUILocked") then
            refresh(false)
        end
    end))

    refresh(false)
    return refresh
end

local function createSectionTitle(section, title)
    local label = create("TextLabel", {
        Name = "SectionTitle",
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = string.upper(title),
        TextColor3 = THEME.SubText,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = section:_nextOrder(),
    }, section.Parent)

    local divider = create("Frame", {
        Name = "SectionDivider",
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = THEME.Accent,
        BackgroundTransparency = 0.58,
        BorderSizePixel = 0,
        LayoutOrder = section:_nextOrder(),
    }, section.Parent)

    section.TitleLabel = label
    section.Divider = divider
end

function SectionMethods:_nextOrder()
    self.Window._layoutOrder = self.Window._layoutOrder + 1
    return self.Window._layoutOrder
end

function SectionMethods:CreateButton(options)
    options = type(options) == "table" and options or {Name = tostring(options)}
    local title = options.Title or options.Name or "Button"

    local button = create("TextButton", {
        Name = "Button",
        Size = UDim2.new(1, 0, 0, 30),
        LayoutOrder = self:_nextOrder(),
        Text = title,
    }, self.Parent)

    local element = setmetatable({
        Type = "Button",
        Title = title,
        Object = button,
        TitleLabel = button,
        Callback = options.Callback,
    }, ElementMethods)

    styleButton(self.Window, button)
    registerConnection(self.Window, button.MouseButton1Click:Connect(function()
        if element.Locked then
            self.Window:Notify({Title = "Control bloqueado", Content = element.LockReason or title, Duration = 3})
            return
        end
        safeCall(element.Callback)
    end))

    function element:Press()
        if not self.Locked then
            safeCall(self.Callback)
        end
    end

    return registerElement(self, element, button)
end

function SectionMethods:CreateToggle(options)
    options = type(options) == "table" and options or {Name = tostring(options)}
    local title = options.Title or options.Name or "Toggle"
    local flag = options.Flag
    local default = options.CurrentValue
    if default == nil then
        default = options.Default
    end
    default = default == true

    local button = create("TextButton", {
        Name = "Toggle",
        Size = UDim2.new(1, 0, 0, 30),
        LayoutOrder = self:_nextOrder(),
        Text = "",
    }, self.Parent)

    local titleLabel = create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -42, 1, 0),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = title,
        TextColor3 = THEME.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    }, button)

    local indicator = create("Frame", {
        Name = "Indicator",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(24, 14),
        BackgroundColor3 = THEME.ButtonAlt,
        BorderSizePixel = 0,
    }, button)
    addCorner(indicator, 7)
    addStroke(indicator, THEME.Border, STYLE.Stroke)

    local knob = create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 7, 0.5, 0),
        Size = UDim2.fromOffset(8, 8),
        BackgroundColor3 = THEME.SubText,
        BorderSizePixel = 0,
    }, indicator)
    addCorner(knob, 4)

    local element = setmetatable({
        Type = "Toggle",
        Title = title,
        Object = button,
        TitleLabel = titleLabel,
        Indicator = indicator,
        Knob = knob,
        Flag = flag,
        Value = default,
        Callback = options.Callback,
    }, ElementMethods)

    local refreshButton = styleButton(self.Window, button, function()
        return element.Value
    end)

    function element:Refresh()
        local active = self.Value == true
        tween(self.Indicator, {
            BackgroundColor3 = active and THEME.Accent or THEME.ButtonAlt,
        })
        tween(self.Knob, {
            Position = active and UDim2.new(1, -7, 0.5, 0) or UDim2.new(0, 7, 0.5, 0),
            BackgroundColor3 = active and Color3.fromRGB(20, 19, 17) or THEME.SubText,
        })
        self.TitleLabel.TextColor3 = active and Color3.fromRGB(20, 19, 17) or THEME.Text
        refreshButton(false)
    end

    function element:Set(value, skipCallback, skipSave)
        value = value == true
        if self.Value == value then
            self:Refresh()
            return self
        end
        updateFlag(self, value, skipSave)
        self:Refresh()
        if not skipCallback then
            safeCall(self.Callback, value)
        end
        return self
    end

    registerConnection(self.Window, button.MouseButton1Click:Connect(function()
        if element.Locked then
            self.Window:Notify({Title = "Control bloqueado", Content = element.LockReason or title, Duration = 3})
            return
        end
        element:Set(not element.Value)
    end))

    registerElement(self, element, button)
    element:Refresh()
    return element
end

function SectionMethods:CreateSlider(options)
    options = type(options) == "table" and options or {}
    local title = options.Title or options.Name or "Slider"
    local minimum = tonumber(options.Range and options.Range[1] or options.Min) or 0
    local maximum = tonumber(options.Range and options.Range[2] or options.Max) or 100
    local increment = tonumber(options.Increment or options.Step) or 1
    local suffix = tostring(options.Suffix or "")
    local default = tonumber(options.CurrentValue or options.Default) or minimum
    default = math.clamp(default, minimum, maximum)

    local container = create("Frame", {
        Name = "Slider",
        Size = UDim2.new(1, 0, 0, 46),
        LayoutOrder = self:_nextOrder(),
    }, self.Parent)
    styleSurface(container, THEME.ButtonAlt)

    local titleLabel = create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -66, 0, 24),
        Position = UDim2.fromOffset(8, 1),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = title,
        TextColor3 = THEME.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, container)

    local valueLabel = create("TextLabel", {
        Name = "Value",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 0, 1),
        Size = UDim2.fromOffset(58, 24),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = "",
        TextColor3 = THEME.SubText,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, container)

    local bar = create("Frame", {
        Name = "Bar",
        Position = UDim2.new(0, 8, 1, -14),
        Size = UDim2.new(1, -16, 0, 5),
        BackgroundColor3 = Color3.fromRGB(40, 37, 32),
        BorderSizePixel = 0,
        Active = true,
    }, container)
    addCorner(bar, 3)

    local fill = create("Frame", {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = THEME.Accent,
        BorderSizePixel = 0,
    }, bar)
    addCorner(fill, 3)

    local knob = create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(10, 10),
        BackgroundColor3 = THEME.CategoryTitle,
        BorderSizePixel = 0,
    }, bar)
    addCorner(knob, 5)
    addStroke(knob, THEME.Border, 0.08)

    local element = setmetatable({
        Type = "Slider",
        Title = title,
        Object = container,
        TitleLabel = titleLabel,
        ValueLabel = valueLabel,
        Bar = bar,
        Fill = fill,
        Knob = knob,
        Flag = options.Flag,
        Value = default,
        Min = minimum,
        Max = maximum,
        Increment = increment,
        Suffix = suffix,
        Callback = options.Callback,
    }, ElementMethods)

    function element:_round(value)
        local stepped = math.floor(((value - self.Min) / self.Increment) + 0.5) * self.Increment + self.Min
        return math.clamp(stepped, self.Min, self.Max)
    end

    function element:Refresh()
        local range = self.Max - self.Min
        local alpha = range == 0 and 0 or (self.Value - self.Min) / range
        self.Fill.Size = UDim2.new(alpha, 0, 1, 0)
        self.Knob.Position = UDim2.new(alpha, 0, 0.5, 0)

        local decimals = 0
        local incrementText = tostring(self.Increment)
        local decimalPart = incrementText:match("%.(%d+)")
        if decimalPart then
            decimals = #decimalPart
        end
        self.ValueLabel.Text = string.format("%." .. tostring(decimals) .. "f%s", self.Value, self.Suffix)
    end

    function element:Set(value, skipCallback, skipSave)
        value = tonumber(value)
        if not value then
            return self
        end
        value = self:_round(value)
        if self.Value == value then
            self:Refresh()
            return self
        end
        updateFlag(self, value, skipSave)
        self:Refresh()
        if not skipCallback then
            safeCall(self.Callback, value)
        end
        return self
    end

    local dragging = false
    local function setFromX(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
        element:Set(element.Min + ((element.Max - element.Min) * alpha))
    end

    registerConnection(self.Window, bar.InputBegan:Connect(function(input)
        if element.Locked then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end))

    registerConnection(self.Window, UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
        end
    end))

    registerConnection(self.Window, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    registerElement(self, element, container)
    element:Refresh()
    return element
end

function SectionMethods:CreateDropdown(options)
    options = type(options) == "table" and options or {}
    local title = options.Title or options.Name or "Dropdown"
    local values = options.Options or options.Values or {}
    local default = options.CurrentOption or options.Value or options.Default or values[1]
    if type(default) == "table" then
        default = default[1]
    end

    local root = create("Frame", {
        Name = "Dropdown",
        Size = UDim2.new(1, 0, 0, 30),
        LayoutOrder = self:_nextOrder(),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, self.Parent)

    local button = create("TextButton", {
        Name = "DropdownButton",
        Size = UDim2.new(1, 0, 0, 30),
        Text = "",
    }, root)

    local titleLabel = create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(0.52, -8, 1, 0),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = title,
        TextColor3 = THEME.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, button)

    local valueLabel = create("TextLabel", {
        Name = "Value",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -8, 0, 0),
        Size = UDim2.new(0.48, -10, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = tostring(default or "Ninguno"),
        TextColor3 = THEME.SubText,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, button)

    local choices = create("Frame", {
        Name = "Choices",
        Position = UDim2.fromOffset(0, 34),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
    }, root)

    local choicesLayout = create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, choices)

    local element = setmetatable({
        Type = "Dropdown",
        Title = title,
        Object = root,
        Button = button,
        TitleLabel = titleLabel,
        ValueLabel = valueLabel,
        Choices = choices,
        Values = values,
        Flag = options.Flag,
        Value = default,
        Open = false,
        Callback = options.Callback,
    }, ElementMethods)

    styleButton(self.Window, button)

    function element:Refresh()
        self.ValueLabel.Text = tostring(self.Value or "Ninguno")
    end

    function element:Set(value, skipCallback, skipSave)
        local found = false
        for _, option in ipairs(self.Values) do
            if option == value then
                found = true
                break
            end
        end
        if not found and #self.Values > 0 then
            return self
        end
        if self.Value == value then
            self:Refresh()
            return self
        end
        updateFlag(self, value, skipSave)
        self:Refresh()
        if not skipCallback then
            safeCall(self.Callback, value)
        end
        return self
    end

    function element:SetOpen(open)
        self.Open = open == true
        self.Choices.Visible = self.Open
        local targetHeight = 30
        if self.Open then
            targetHeight = 38 + self.ChoicesLayoutHeight
        end
        tween(self.Object, {Size = UDim2.new(1, 0, 0, targetHeight)})
    end

    function element:RefreshOptions(newValues)
        self.Values = newValues or {}
        for _, child in ipairs(self.Choices:GetChildren()) do
            if child:IsA("GuiButton") then
                child:Destroy()
            end
        end

        for index, option in ipairs(self.Values) do
            local optionButton = create("TextButton", {
                Name = "Option",
                Size = UDim2.new(1, 0, 0, 26),
                LayoutOrder = index,
                Text = tostring(option),
            }, self.Choices)
            styleButton(self.Window, optionButton, function()
                return self.Value == option
            end)
            registerConnection(self.Window, optionButton.MouseButton1Click:Connect(function()
                self:Set(option)
                self:SetOpen(false)
            end))
        end

        self.ChoicesLayoutHeight = math.max(0, (#self.Values * 26) + (math.max(0, #self.Values - 1) * 4))
        self.Choices.Size = UDim2.new(1, 0, 0, self.ChoicesLayoutHeight)
        if self.Open then
            self:SetOpen(true)
        end
        return self
    end

    registerConnection(self.Window, button.MouseButton1Click:Connect(function()
        if element.Locked then
            self.Window:Notify({Title = "Control bloqueado", Content = element.LockReason or title, Duration = 3})
            return
        end
        element:SetOpen(not element.Open)
    end))

    registerElement(self, element, root)
    element:RefreshOptions(values)
    element:Refresh()
    return element
end

function SectionMethods:CreateParagraph(options)
