        local sectionTitle = element.Section and window:_translate(element.Section.SourceTitle or element.Section.Title) or "GENERAL"
        local metadata = string.format("%s  ·  %s  ·  %s", tabTitle, sectionTitle, window:_translate(element.Type or "CONTROL"))
        local metaLabel = create("TextLabel", {
            Name = "Metadata",
            Position = UDim2.fromOffset(11, 39),
            Size = UDim2.new(1, -22, 0, 16),
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            Text = metadata,
            TextColor3 = THEME.SubText,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 83,
        }, row)

        local interact = create("TextButton", {
            Name = "Interact",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 84,
        }, row)

        searchConnections[#searchConnections + 1] = interact.MouseEnter:Connect(function()
            tween(row, {
                BackgroundColor3 = THEME.Hover,
                BackgroundTransparency = STYLE.AcrylicHover,
            })
            tween(titleLabel, {TextColor3 = THEME.CategoryTitle})
            tween(metaLabel, {TextColor3 = THEME.Text})
            tween(stroke, {Transparency = STYLE.StrokeHover})
        end)
        searchConnections[#searchConnections + 1] = interact.MouseLeave:Connect(function()
            tween(row, {
                BackgroundColor3 = THEME.Button,
                BackgroundTransparency = STYLE.Acrylic,
            })
            tween(titleLabel, {TextColor3 = THEME.Text})
            tween(metaLabel, {TextColor3 = THEME.SubText})
            tween(stroke, {Transparency = STYLE.Stroke})
        end)
        searchConnections[#searchConnections + 1] = interact.MouseButton1Click:Connect(function()
            focusSearchTarget(element)
        end)
    end

    local function scoreSearchElement(element, terms)
        local title = normalizeSearchText((element.Title or "") .. " " .. window:_translate(element.SourceTitle or element.Title or ""))
        local description = normalizeSearchText((element.Description or "") .. " " .. window:_translate(element.SourceDescription or element.Description or ""))
        local flag = normalizeSearchText(element.Flag)
        local tabSource = element.Tab and (element.Tab.SourceTitle or element.Tab.Title) or ""
        local sectionSource = element.Section and (element.Section.SourceTitle or element.Section.Title) or ""
        local tab = normalizeSearchText(tabSource .. " " .. window:_translate(tabSource))
        local section = normalizeSearchText(sectionSource .. " " .. window:_translate(sectionSource))
        local optionsText = ""
        if type(element.Values) == "table" then
            local optionParts = {}
            for _, optionValue in ipairs(element.Values) do
                optionParts[#optionParts + 1] = tostring(optionValue)
                optionParts[#optionParts + 1] = window:_translate(tostring(optionValue))
            end
            optionsText = normalizeSearchText(table.concat(optionParts, " "))
        end

        local total = 0
        for _, term in ipairs(terms) do
            if title == term then
                total = total + 120
            elseif title:sub(1, #term) == term then
                total = total + 80
            elseif title:find(term, 1, true) then
                total = total + 55
            elseif flag:find(term, 1, true) then
                total = total + 38
            elseif section:find(term, 1, true) or tab:find(term, 1, true) then
                total = total + 24
            elseif optionsText:find(term, 1, true) then
                total = total + 18
            elseif description:find(term, 1, true) then
                total = total + 10
            else
                return nil
            end
        end
        return total
    end

    local function refreshSearchResults()
        if window.Destroyed or not searchResults.Parent then
            return
        end

        clearSearchResults()
        local terms = expandSearchTerms(searchBox.Text)
        if #terms == 0 then
            searchHint.Visible = true
            searchHintSource = "Type the name of a feature or setting."
            window:_applyTranslationBinding(searchHintBinding)
            if window._focusOwner == searchPanel then
                window:_raiseFocusedObject(searchPanel)
            end
            return
        end

        local matches = {}
        for element in pairs(window._elements) do
            if element.Object and element.Object.Parent and element.Type ~= "Divider" and element.Visible ~= false then
                local score = scoreSearchElement(element, terms)
                if score then
                    matches[#matches + 1] = {Element = element, Score = score}
                end
            end
        end

        table.sort(matches, function(a, b)
            if a.Score == b.Score then
                return normalizeSearchText(a.Element.Title) < normalizeSearchText(b.Element.Title)
            end
            return a.Score > b.Score
        end)

        searchHint.Visible = #matches == 0
        searchHintSource = "No controls found."
        window:_applyTranslationBinding(searchHintBinding)

        window._firstSearchElement = matches[1] and matches[1].Element or nil
        local visualOrder = 1
        for index, match in ipairs(matches) do
            if index > 50 then
                break
            end
            visualOrder = visualOrder + 1
            createSearchResultButton(match.Element, visualOrder)
        end
        if window._focusOwner == searchPanel then
            window:_raiseFocusedObject(searchPanel)
        end
    end
    window._refreshSearchResults = refreshSearchResults
    window.SearchPanel = searchPanel
    window.SearchInput = searchBox
    window.SearchResults = searchResults

    registerConnection(window, legalPlusButton.MouseButton1Click:Connect(function()
        if #window.Tabs <= PRIMARY_TAB_LIMIT then
            return
        end
        window.TabPage = window.TabPage == 1 and 2 or 1
        window:_playSound("Tab")
        window:_refreshTabPage()
    end))

    registerConnection(window, menuButton.MouseButton1Click:Connect(function()
        window:SetMenuVisibility(not window.MenuVisible)
    end))
    registerConnection(window, searchButton.MouseButton1Click:Connect(function()
        togglePanel(searchPanel)
        if searchPanel.Visible then
            refreshSearchResults()
            searchBox:CaptureFocus()
        end
    end))
    registerConnection(window, infoButton.MouseButton1Click:Connect(function()
        togglePanel(infoPanel)
    end))
    registerConnection(window, settingsButton.MouseButton1Click:Connect(function()
        togglePanel(settingsPanel)
    end))
    local searchToken = 0
    registerConnection(window, searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        searchToken = searchToken + 1
        local token = searchToken
        task.delay(SEARCH_DEBOUNCE, function()
            if token == searchToken and not window.Destroyed then
                refreshSearchResults()
            end
        end)
    end))
    registerConnection(window, searchBox.FocusLost:Connect(function(enterPressed)
        if enterPressed and window._firstSearchElement then
            focusSearchTarget(window._firstSearchElement)
        end
    end))

    local dragging = false
    local dragStart
    local startPosition

    local function syncFloatingPositions()
        immersive.UserDock.Position = UDim2.new(
            mainBar.Position.X.Scale,
            mainBar.Position.X.Offset,
            mainBar.Position.Y.Scale,
            mainBar.Position.Y.Offset - USER_DOCK_GAP
        )
        mainContainer.Position = UDim2.new(
            mainBar.Position.X.Scale,
            mainBar.Position.X.Offset,
            mainBar.Position.Y.Scale,
            mainBar.Position.Y.Offset + 50
        )
        local target = floatingPanelTarget()
        for _, panel in ipairs(floatingPanels) do
            if panel:GetAttribute("VanillaUIAnimating") ~= true then
                panel.Position = target
            end
        end
    end
    window._syncFloatingPositions = syncFloatingPositions

    local function clampMainBarPosition(position)
        local camera = Workspace.CurrentCamera
        if not camera then return position end
        local viewport = camera.ViewportSize
        local effectiveScale = window.UIScale.EffectiveScale
        local barWidth = math.max(180, mainBar.AbsoluteSize.X)
        local half = barWidth * 0.5
        local x
        if window._singleTabMode then
            x = 0
        else
            x = math.clamp(position.X.Offset, -viewport.X * 0.5 + half + 6, viewport.X * 0.5 - half - 6)
        end
        local y = math.clamp(position.Y.Offset, TOP_SAFE_OFFSET, math.max(TOP_SAFE_OFFSET, viewport.Y - 58))
        return UDim2.new(0.5, x, 0, y)
    end

    local function beginDockDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = mainBar.Position
        end
    end
    registerConnection(window, mainBar.InputBegan:Connect(beginDockDrag))
    registerConnection(window, immersive.UserDock.InputBegan:Connect(beginDockDrag))

    registerConnection(window, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if window._activeDragControl then
            if type(window._activeDragControl._setFromPosition) == "function" then
                window._activeDragControl:_setFromPosition(input.Position)
            elseif type(window._activeDragControl._setFromX) == "function" then
                window._activeDragControl:_setFromX(input.Position.X)
            end
        end

        if dragging then
            local delta = input.Position - dragStart
            mainBar.Position = clampMainBarPosition(UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            ))
            syncFloatingPositions()
        end
    end))

    registerConnection(window, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            window._activeDragControl = nil
        end
        for keybind in pairs(window._heldKeybinds) do
            if input.KeyCode == keybind.value then
                window._heldKeybinds[keybind] = nil
                safeCall(keybind.Callback, false, input)
            end
        end
    end))

    registerConnection(window, UserInputService.InputBegan:Connect(function(input, processed)
        local capture = window._capturingKeybind
        if capture then
            if input.KeyCode == Enum.KeyCode.Escape then
                capture.Capturing = false
                window._capturingKeybind = nil
                capture:Refresh()
                return
            end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                capture.Capturing = false
                window._capturingKeybind = nil
                capture:Set(input.KeyCode)
            end
            return
        end

        if input.KeyCode == Enum.KeyCode.Escape and window._focusOwner and window.FocusMode.CloseOnEscape ~= false then
            if type(window._focusClose) == "function" then
                safeCall(window._focusClose)
            end
            return
        end

        if processed then
            return
        end
        if input.KeyCode == window.ToggleKey then
            window:Toggle()
            return
        end

        for keybind in pairs(window._keybinds) do
            if not keybind.Locked and keybind.value == input.KeyCode then
                if keybind.HoldToInteract then
                    if not window._heldKeybinds[keybind] then
                        window._heldKeybinds[keybind] = true
                        safeCall(keybind.Callback, true, input)
                    end
                else
                    safeCall(keybind.Callback, input)
                end
            end
        end
    end))

    local cameraViewportConnection
    local function connectViewport(camera)
        disconnect(cameraViewportConnection)
        cameraViewportConnection = nil
        if camera then
            cameraViewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                if type(window._updateResponsiveSize) == "function" then
                    window._updateResponsiveSize()
                end
            end)
            window._connections[#window._connections + 1] = cameraViewportConnection
        end
    end

    local function updateResponsiveSize()
        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end
        local viewport = camera.ViewportSize
        local rules = window.ResponsiveRules or DEFAULT_RESPONSIVE_RULES
        local mode
        if viewport.X >= rules.Wide then
            mode = "Wide"
        elseif viewport.X >= rules.Compact then
            mode = "Compact"
        else
            mode = "Mobile"
        end
        window.ResponsiveMode = mode
        window._singleTabMode = mode ~= "Wide"

        local responsive = 1
        if window.AutoScale then
            if mode == "Mobile" then
                responsive = (viewport.X < rules.Mobile or viewport.Y < 440) and 0.86 or 0.91
            elseif mode == "Compact" then
                responsive = viewport.Y < 560 and 0.91 or 0.95
            end
        end
        window._setResponsiveScale(responsive)

        local effectiveScale = window.UIScale.EffectiveScale
        local safeWidth = math.max(300, (viewport.X - 24) / effectiveScale)
        local safeHeight = math.max(250, (viewport.Y - 96) / effectiveScale)
        local widthLimit = mode == "Wide" and 980 or (mode == "Compact" and 660 or 460)
        local heightLimit = mode == "Wide" and 470 or (mode == "Compact" and 500 or 540)
        local width = math.clamp(safeWidth, mode == "Mobile" and 300 or 320, widthLimit)
        local height = math.clamp(safeHeight, 250, heightLimit)
        mainContainer.Size = UDim2.fromOffset(width, height)

        local barLayout = mainBar:FindFirstChildOfClass("UIListLayout")
        if barLayout then
            barLayout.Padding = UDim.new(0, mode == "Mobile" and 4 or (mode == "Compact" and 6 or 7))
        end
        menuButton.Size = UDim2.fromOffset(mode == "Mobile" and 70 or (mode == "Compact" and 83 or 94), 39)
        immersive.MobileNavButton.Size = UDim2.fromOffset(mode == "Mobile" and 98 or 110, 39)
        immersive.UserDock.Size = UDim2.fromOffset(mode == "Mobile" and 45 or (mode == "Compact" and 134 or 154), 39)
        immersive.UserButton.Size = UDim2.fromScale(1, 1)
        immersive.UserName.Visible = mode ~= "Mobile"
        immersive.UserStatus.Visible = mode ~= "Mobile"
        infoButton.Visible = mode == "Wide"
        immersive.ActivityButton.Visible = false
        settingsButton.Size = UDim2.fromOffset(39, 39)
        searchButton.Size = UDim2.fromOffset(39, 39)

        local holderLayout = tabHolder:FindFirstChildOfClass("UIListLayout")
        if holderLayout then
            holderLayout.HorizontalAlignment = window._singleTabMode and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Center
        end
        for _, tab in ipairs(window.Tabs) do
            tab.Object.Size = window._singleTabMode and UDim2.new(1, -4, 1, -4) or UDim2.new(0, window.TabWidth, 1, -4)
        end
        window:_refreshTabPage()
        window:_applyDescriptionVisibility()

        local notificationWidth = mode == "Mobile" and math.max(270, math.min(330, viewport.X - 24)) or DEFAULT_NOTIFICATION_WIDTH
        notificationHolder.Size = UDim2.fromOffset(notificationWidth, math.max(250, viewport.Y - 28))
        notificationHolder.Position = UDim2.new(1, -12, 1, -12)

        for _, panel in ipairs(floatingPanels) do
            local baseWidth = panel:GetAttribute("VanillaUIBaseWidth") or 380
            local baseHeight = panel:GetAttribute("VanillaUIBaseHeight") or 260
            local maxPanelWidth = math.max(280, (viewport.X - 24) / effectiveScale)
            local maxPanelHeight = math.max(210, (viewport.Y - 90) / effectiveScale)
            panel.Size = UDim2.fromOffset(
                math.min(baseWidth, maxPanelWidth),
                math.min(baseHeight, maxPanelHeight)
            )
        end

        mainBar.Position = clampMainBarPosition(mainBar.Position)
        syncFloatingPositions()
    end
    window._updateResponsiveSize = updateResponsiveSize

    updateResponsiveSize()
    connectViewport(Workspace.CurrentCamera)
    registerConnection(window, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        CurrentCamera = Workspace.CurrentCamera
        connectViewport(CurrentCamera)
        updateResponsiveSize()
    end))

    if not window._localeExplicit and LocalPlayer then
        registerConnection(window, LocalPlayer:GetPropertyChangedSignal("LocaleId"):Connect(function()
            window.Locale = normalizeLocaleId(LocalPlayer.LocaleId)
            window:RefreshTranslations()
            window:_refreshUser()
            window:_refreshMobileNav()
        end))
    end

    window:_refreshUser()
    window:_refreshActivityEmpty()
    window:_refreshActivityBadge()
    window:_refreshMobileNav()
    task.spawn(function()
        while not window.Destroyed do
            if immersive.ProfileValues and immersive.ProfileValues["Session time"] then
                immersive.ProfileValues["Session time"].Text = formatSessionTime(os.clock() - window._sessionStarted)
            end
            task.wait(1)
        end
    end)
    window:LogActivity({Title = window.Title, Content = "Ready", State = "Success"})

    window._cleanupFunction = function()
        window:Destroy()
    end
    GLOBAL_ENV[CLEANUP_KEY] = window._cleanupFunction
    window:_refreshTabPage()
    window:RefreshTranslations()

    return window
end

function VanillaUI:Notify(options)
    if self.ActiveWindow and not self.ActiveWindow.Destroyed then
        return self.ActiveWindow:Notify(options)
    end
end

local originalCreateWindow = VanillaUI.CreateWindow
function VanillaUI:CreateWindow(options)
    local window = originalCreateWindow(self, options)
    self.ActiveWindow = window
    return window
end

function VanillaUI:Destroy()
    if self.ActiveWindow then
        self.ActiveWindow:Destroy()
        self.ActiveWindow = nil
    end
end


--[==[
# VanillaUI v0.7.8, documentación completa de API

## 1. Propósito

VanillaUI es una biblioteca privada de interfaz para scripts Luau de Roblox. Mantiene la identidad visual de V+ Sentinel y ofrece ventanas, categorías, secciones, controles, traducciones, configuraciones, sonido, modo de enfoque, diseño adaptable, perfil de usuario, introducción, notificaciones e historial de actividad dentro de Ajustes.

Esta documentación funciona como contrato técnico para desarrolladores y para otras IA. Al crear módulos nuevos, conserva la API pública y separa la lógica funcional de la construcción visual.

## 2. Carga

```lua
local VanillaUI = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/vista8kolo/VanillaUI/refs/heads/main/a"
))()
```

La URL debe devolver el archivo completo de VanillaUI. La última expresión del archivo debe ser `return VanillaUI`.

## 3. Ejemplo mínimo

```lua
local VanillaUI = loadstring(game:HttpGet(VANILLA_UI_URL))()

local Window = VanillaUI:CreateWindow({
    Name = "V+ Sentinel",
    Subtitle = "Vanilla Lattice",
    ToggleKey = Enum.KeyCode.Delete,
})

local Tab = Window:CreateTab({Title = "INTELLIGENCE"})
local Section = Tab:CreateSection({Title = "ESP"})

local EspToggle = Section:CreateToggle({
    Name = "Player ESP",
    Flag = "PlayerESP",
    Default = false,
    Callback = function(enabled)
        print("ESP:", enabled)
    end,
})
```

## 4. CreateWindow

```lua
local Window = VanillaUI:CreateWindow(options)
```

### Opciones de ventana

| Campo | Tipo | Valor base | Uso |
|---|---|---:|---|
| `Name`, `Title` | string | `VanillaUI` | Nombre principal. |
| `Subtitle`, `LoadingSubtitle` | string | `Vanilla Lattice` | Subtítulo y texto auxiliar. |
| `ToggleKey`, `ToggleUIKeybind` | Enum.KeyCode o string | `Delete` | Muestra u oculta la interfaz. |
| `TabWidth`, `CategoryWidth` | number | `180` | Ancho de cada categoría, limitado entre 155 y 250. |
| `Scale` | number | `0.92` | Escala manual, limitada entre 0.76 y 1.18. |
| `AutoScale`, `Responsive` | boolean | `true` | Ajusta escala y estructura según el viewport. |
| `MenuVisible` | boolean | `true` | Estado inicial de las categorías. |
| `DisplayOrder` | number | `1000` | Orden del `ScreenGui`. |
| `MobileDescriptionsCollapsed` | boolean | `true` | Oculta descripciones en modo móvil. |
| `Locale` | string | idioma de Roblox | Idioma inicial. |
| `Translations` | table | `{}` | Paquetes de traducción. |
| `Translator` | function | nil | Resolutor personalizado `(source, localeId)`. |
| `ConfigurationSaving` | table | desactivado | Guardado local de flags. |
| `SoundProfile` | table o false | desactivado | Perfil de sonidos. |
| `FocusMode` | table o boolean | activado | Enfoque automático para tareas emergentes. |
| `ResponsiveRules` | table | 1100/760/520 | Límites Wide, Compact y Mobile. |
| `User` | table, true o false | nil | Perfil de usuario. |
| `Intro` | table o true | nil | Introducción previa a la ventana. |
| `ActivityLimit` | number | `100` | Máximo de registros del historial integrado en Ajustes. |

### ConfigurationSaving

```lua
ConfigurationSaving = {
    Enabled = true,
    FolderName = "VanillaUI",
    FileName = "Sentinel",
}
```

Requiere que el entorno exponga `writefile`, `readfile`, `isfile`, `makefolder` e `isfolder`. Si no están disponibles, la interfaz sigue funcionando sin persistencia.

## 5. Métodos públicos de Window

### Navegación y ciclo de vida

```lua
Window:CreateTab(options)
Window:CreateCategory(options) -- alias
Window:Tab(options)            -- alias
Window:SetVisibility(true)
Window:IsVisible()
Window:Toggle()
Window:SetMenuVisibility(true)
Window:AddCleanup(callback)
Window:Destroy()
```

`AddCleanup` registra tareas propias del script. VanillaUI las ejecuta al destruir la ventana.

### Flags y controles

```lua
Window:Get("PlayerESP")
Window:Set("PlayerESP", true)
Window:Set("PlayerESP", true, true) -- omite callback
Window:GetElement("PlayerESP")
Window:ResetConfiguration(false)
Window:SaveConfiguration()
Window:LoadConfiguration()
```

`Window.Flags` contiene los valores actuales. `VanillaUI.Flags` mantiene un espejo global de las flags activas.

### Localización

```lua
Window:SetLocale("es")
Window:GetLocale()
Window:RegisterTranslations({
    es = { ["Player ESP"] = "ESP de jugadores" },
})
Window:SetTranslator(function(source, localeId)
    return nil
end)
Window:RefreshTranslations()
```

### Experiencia inmersiva

```lua
Window:SetSoundProfile(profile)
Window:SetFocusMode(settings)
Window:SetResponsiveRules(rules)
Window:GetResponsiveMode()
Window:SetUser(profile)
Window:GetUser()
Window:PlayIntro(options)
```

### Actividad y avisos

```lua
Window:Notify(options)
Window:Toast(options) -- alias
Window:LogActivity(options)
Window:GetActivities()
Window:ClearActivities()
```

## 6. Tabs, Sections y Groups

### Tab

```lua
local Tab = Window:CreateTab({
    Title = "INTELLIGENCE",
    Color = Color3.fromRGB(208, 193, 162),
})
```

También admite:

```lua
local Tab = Window:CreateTab("INTELLIGENCE")
```

Métodos:

```lua
Tab:CreateSection(options)
Tab:Set("NEW TITLE")
Tab:SetVisible(true)
Tab:Remove()
```

Un Tab puede crear controles directamente. VanillaUI crea una sección interna automática:

```lua
Tab:CreateButton(...)
Tab:CreateToggle(...)
Tab:CreateSwitch(...)
Tab:CreateSlider(...)
Tab:CreateDropdown(...)
Tab:CreateInput(...)
Tab:CreateKeybind(...)
Tab:CreateColorPicker(...)
Tab:CreateStat(...)
Tab:CreateParagraph(...)
Tab:CreateLabel(...)
Tab:CreateDivider()
Tab:CreateGroup(...)
```

### Section

```lua
local Section = Tab:CreateSection({Title = "ESP"})
Section:Set("VISUALS")
Section:SetVisible(true)
```

Aliases disponibles:

```lua
Section:Button(...)
Section:Toggle(...)
Section:Switch(...)
Section:Slider(...)
Section:Dropdown(...)
Section:Input(...)
Section:Keybind(...)
Section:ColorPicker(...)
Section:Colorpicker(...)
Section:Stat(...)
Section:Paragraph(...)
Section:Label(...)
Section:Divider()
Section:Group(...)
```

### Group

```lua
local Group = Section:CreateGroup({
    Name = "Quick actions",
    Direction = "Row", -- Row/Horizontal o Column
    Columns = 2,
    Spacing = 6,
    MinimumCellWidth = 160,
})

Group:CreateButton(...)
Group:CreateToggle(...)
```

Los grupos reutilizan la API de Section. Los grupos horizontales cambian
automáticamente a una columna cuando el espacio disponible haría que los
controles quedaran demasiado estrechos.

## 7. Propiedades compartidas por los controles

Los controles aceptan variantes con mayúscula o minúscula:

```lua
{
    Name = "Control",
    Title = "Control",          -- alias de Name
    Description = "Details",
    Desc = "Details",           -- alias
    Icon = "rbxassetid://...",  -- string o número
    Flag = "StableIdentifier",
    ForgetState = false,
    Callback = function(value) end,
}
```

Usa una `Flag` explícita cuando el nombre pueda traducirse, renombrarse o repetirse.

## 8. Handle común de elementos

Los métodos que crean controles devuelven un handle. Los controles con valor exponen `.value` y `.Value`.

```lua
Control:Set(value)
Control:Set(value, true)        -- cambia UI y valor, omite callback
Control:Set(value, true, true)  -- también omite guardado
Control:SetVisible(true)
Control:SetTitle("New name")
Control:SetName("New name")
Control:SetDescription("New description")
Control:SetDesc("New description")
Control:Lock("Reason")
Control:Unlock()
Control:MoveTo(3)
Control:MoveToTop()
Control:MoveToBottom()
Control:MoveUp()
Control:MoveDown()
Control:Destroy()
Control:Remove()                -- alias
```

No todos los elementos usan `Set` con la misma firma. Revisa la sección específica.

## 9. Button

```lua
local Button = Section:CreateButton({
    Name = "Refresh players",
    Description = "Rebuilds the player cache.",
    Callback = function()
        print("Pressed")
    end,
})
```

