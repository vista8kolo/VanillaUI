local function createElementHeader(parent, window, options, rightWidth, minimumHeight, bottomReserve, onHeightChanged)
    options = options or {}
    rightWidth = math.max(8, tonumber(rightWidth) or 10)
    minimumHeight = math.max(38, tonumber(minimumHeight) or 44)
    bottomReserve = math.max(0, tonumber(bottomReserve) or 0)

