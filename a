function WindowMethods:_restoreFocusedZ()
    for object, value in pairs(self._focusZCache or {}) do
        if object and object.Parent then
            object.ZIndex = value
        end
    end
    self._focusZCache = setmetatable({}, {__mode = "k"})
end

function WindowMethods:_raiseFocusedObject(owner)
    self:_restoreFocusedZ()
    if not owner or not owner:IsA("GuiObject") then
        return
    end
    self._focusZCache = self._focusZCache or setmetatable({}, {__mode = "k"})
    local function raise(object)
        if object:IsA("GuiObject") then
            self._focusZCache[object] = object.ZIndex
            object.ZIndex = 170 + math.clamp(object.ZIndex, 0, 80)
        end
    end
    raise(owner)
    for _, descendant in ipairs(owner:GetDescendants()) do
        raise(descendant)
    end
end

function WindowMethods:_beginFocus(owner, closeCallback, title)
    local mode = self.FocusMode or DEFAULT_FOCUS_MODE
    if mode.Enabled == false or not self.FocusOverlay then
        return self
    end

    if self._focusOwner and self._focusOwner ~= owner and type(self._focusClose) == "function" and not self._focusChanging then
        self._focusChanging = true
        safeCall(self._focusClose)
        self._focusChanging = false
    end

    self._focusToken = (self._focusToken or 0) + 1
    self._focusOwner = owner
    self._focusClose = closeCallback
    self._focusTitle = title
    self:_raiseFocusedObject(owner)

    local overlay = self.FocusOverlay
    overlay.Visible = true
    overlay.Active = true
    TweenService:Create(overlay, STYLE.TweenPanel, {
        BackgroundTransparency = 1 - mode.DimAmount,
    }):Play()

    if self.FocusBlur then
        self.FocusBlur.Enabled = mode.Blur > 0
        TweenService:Create(self.FocusBlur, STYLE.TweenPanel, {Size = mode.Blur}):Play()
    end
    return self
end

function WindowMethods:_endFocus(owner, immediate)
    if owner and self._focusOwner ~= owner then
        return self
    end

    self._focusToken = (self._focusToken or 0) + 1
    local token = self._focusToken
    self._focusOwner = nil
    self._focusClose = nil
    self._focusTitle = nil

    local overlay = self.FocusOverlay
    if overlay then
        if immediate then
            overlay.BackgroundTransparency = 1
            overlay.Visible = false
            overlay.Active = false
        else
            TweenService:Create(overlay, STYLE.TweenPanel, {BackgroundTransparency = 1}):Play()
            task.delay(STYLE.TweenPanel.Time, function()
                if overlay and overlay.Parent and not self._focusOwner and self._focusToken == token then
                    overlay.Visible = false
                    overlay.Active = false
                end
            end)
        end
    end

    if self.FocusBlur then
        if immediate then
            self.FocusBlur.Size = 0
            self.FocusBlur.Enabled = false
        else
            TweenService:Create(self.FocusBlur, STYLE.TweenPanel, {Size = 0}):Play()
            task.delay(STYLE.TweenPanel.Time, function()
                if self.FocusBlur and self.FocusBlur.Parent and not self._focusOwner and self._focusToken == token then
                    self.FocusBlur.Enabled = false
                end
            end)
        end
    end

    if immediate then
        self:_restoreFocusedZ()
    else
        task.delay(STYLE.TweenPanel.Time, function()
            if not self._focusOwner and self._focusToken == token then
                self:_restoreFocusedZ()
            end
        end)
    end
    return self
end

