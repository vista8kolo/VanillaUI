    local function nextPanelAnimationToken(panel)
        local token = (panel:GetAttribute("VanillaUIAnimationToken") or 0) + 1
        panel:SetAttribute("VanillaUIAnimationToken", token)
        return token
    end
    local panelVisualCache = setmetatable({}, {__mode = "k"})

    local function capturePanelVisuals(panel)
        local cached = panelVisualCache[panel]
        if cached then
            return cached
        end
        cached = {}
        for _, item in ipairs(panel:GetDescendants()) do
            local state = {}
            if item:IsA("GuiObject") then
                state.BackgroundTransparency = item.BackgroundTransparency
            end
            if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
                state.TextTransparency = item.TextTransparency
                state.TextStrokeTransparency = item.TextStrokeTransparency
            elseif item:IsA("ImageLabel") or item:IsA("ImageButton") then
                state.ImageTransparency = item.ImageTransparency
            elseif item:IsA("UIStroke") then
                state.Transparency = item.Transparency
            end
            if next(state) then
                cached[item] = state
            end
        end
        panelVisualCache[panel] = cached
        return cached
    end

    local function setPanelVisuals(panel, hidden, animate)
        local cached = capturePanelVisuals(panel)
        for item, state in pairs(cached) do
            if item and item.Parent then
                local target = {}
                for property, original in pairs(state) do
                    target[property] = hidden and 1 or original
                end
                if animate then
                    TweenService:Create(item, STYLE.TweenPanel, target):Play()
                else
                    for property, value in pairs(target) do
                        item[property] = value
                    end
                end
            end
        end
    end


    local function openFloatingPanel(panel)
        if not panel then
            return
        end
        local token = nextPanelAnimationToken(panel)
        local target = floatingPanelTarget()
        panel:SetAttribute("VanillaUIAnimating", true)
        panel.Visible = true
        panel.Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + 10)
        panel.BackgroundTransparency = 1
        local stroke = panel:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Transparency = 1 end
        setPanelVisuals(panel, true, false)
        TweenService:Create(panel, STYLE.TweenPanel, {
            Position = target,
            BackgroundTransparency = 0.04,
        }):Play()
        if stroke then
            TweenService:Create(stroke, STYLE.TweenPanel, {Transparency = STYLE.Stroke}):Play()
        end
        setPanelVisuals(panel, false, true)
        task.delay(STYLE.TweenPanel.Time, function()
            if panel and panel.Parent and panel:GetAttribute("VanillaUIAnimationToken") == token then
                panel:SetAttribute("VanillaUIAnimating", false)
            end
        end)
    end

    local function closeFloatingPanel(panel, immediate)
        if not panel or not panel.Visible then
            return
        end
        local token = nextPanelAnimationToken(panel)
        local target = floatingPanelTarget()
        panel:SetAttribute("VanillaUIAnimating", true)
        if immediate then
            setPanelVisuals(panel, true, false)
            panel.Visible = false
            panel.Position = target
            panel.BackgroundTransparency = 0.04
            setPanelVisuals(panel, false, false)
            panel:SetAttribute("VanillaUIAnimating", false)
            return
        end
        local stroke = panel:FindFirstChildOfClass("UIStroke")
        setPanelVisuals(panel, true, true)
        TweenService:Create(panel, STYLE.TweenPanel, {
            Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + 8),
            BackgroundTransparency = 1,
        }):Play()
        if stroke then
            TweenService:Create(stroke, STYLE.TweenPanel, {Transparency = 1}):Play()
        end
        task.delay(STYLE.TweenPanel.Time, function()
            if panel and panel.Parent and panel:GetAttribute("VanillaUIAnimationToken") == token then
                panel.Visible = false
                panel.Position = target
                panel.BackgroundTransparency = 0.04
                if stroke then stroke.Transparency = STYLE.Stroke end
                setPanelVisuals(panel, false, false)
                panel:SetAttribute("VanillaUIAnimating", false)
            end
        end)
    end

    function window:_closeFloatingPanel(panel, immediate)
        closeFloatingPanel(panel, immediate)
    end

    local function hideFloatingPanels(except)
        for _, panel in ipairs(floatingPanels) do
