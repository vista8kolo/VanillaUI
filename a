function SectionMethods:CreateGroup(options)
    options = type(options) == "table" and options or {}
    local direction = string.lower(tostring(option(options, {"direction", "Direction"}, "column")))
    local requestedRow = direction == "row" or direction == "horizontal"
    local requestedColumns = math.clamp(math.floor(tonumber(option(options, {"columns", "Columns"}, 2)) or 2), 1, 4)
    local spacing = math.clamp(tonumber(option(options, {"spacing", "Spacing"}, 6)) or 6, 0, 16)
    local minimumCellWidth = math.clamp(
        tonumber(option(options, {"minimumCellWidth", "MinimumCellWidth", "minCellWidth", "MinCellWidth"}, MIN_CONTROL_WIDTH)) or MIN_CONTROL_WIDTH,
        120,
        260
    )

    local frame = create("Frame", {
        Name = "Group",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.None,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.Parent)

    local group = setmetatable({
        Window = self.Window,
        Tab = self.Tab,
        Parent = frame,
        Object = frame,
        Title = tostring(option(options, {"name", "Name", "title", "Title"}, "Group")),
        Elements = {},
        IsGroup = true,
        RequestedRow = requestedRow,
        RequestedColumns = requestedColumns,
        Direction = "Column",
        Columns = 1,
        Spacing = spacing,
        MinimumCellWidth = minimumCellWidth,
        Layout = nil,
    }, {__index = SectionMethods})

    local lastWidth = -1

    local function elementHeight(element)
        local object = element and element.Object
        if not object or not object.Parent then
            return 0
        end
        local offset = object.Size.Y.Offset
        if offset and offset > 0 then
            return offset
        end
        return math.max(0, math.floor(object.AbsoluteSize.Y + 0.5))
    end

    function group:_refreshGroupSize()
        local count = #self.Elements
        if count == 0 then
            self.Object.Size = UDim2.new(1, 0, 0, 0)
            return
        end

        if self.Direction == "Row" and self.Layout and self.Layout:IsA("UIGridLayout") then
            local cellHeight = 44
            for _, element in ipairs(self.Elements) do
                cellHeight = math.max(cellHeight, elementHeight(element))
            end
            self.Layout.CellSize = UDim2.new(
                1 / self.Columns,
                -math.ceil((self.Spacing * math.max(0, self.Columns - 1)) / self.Columns),
                0,
                cellHeight
            )
            local rows = math.max(1, math.ceil(count / self.Columns))
            self.Object.Size = UDim2.new(1, 0, 0, rows * cellHeight + math.max(0, rows - 1) * self.Spacing)
        else
            local total = 0
            for _, element in ipairs(self.Elements) do
                total = total + elementHeight(element)
            end
            total = total + math.max(0, count - 1) * self.Spacing
            self.Object.Size = UDim2.new(1, 0, 0, total)
        end
    end

    function group:_refreshGroupLayout(force)
        local width = math.floor(self.Object.AbsoluteSize.X + 0.5)
        if width < 40 then
            width = estimateControlWidth(self.Window, self.Object)
        end
        if not force and width == lastWidth then
            self:_refreshGroupSize()
            return
        end
        lastWidth = width

        local maximumColumns = math.max(1, math.floor((width + self.Spacing) / (self.MinimumCellWidth + self.Spacing)))
        local columns = self.RequestedRow and math.clamp(math.min(self.RequestedColumns, maximumColumns), 1, self.RequestedColumns) or 1
        local useGrid = self.RequestedRow and columns > 1

        if self.Layout then
            destroy(self.Layout)
            self.Layout = nil
        end

        self.Columns = useGrid and columns or 1
        self.Direction = useGrid and "Row" or "Column"

        if useGrid then
            self.Layout = create("UIGridLayout", {
                CellPadding = UDim2.fromOffset(self.Spacing, self.Spacing),
                CellSize = UDim2.new(1 / self.Columns, 0, 0, 56),
                FillDirectionMaxCells = self.Columns,
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, self.Object)
        else
            self.Layout = create("UIListLayout", {
                Padding = UDim.new(0, self.Spacing),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, self.Object)
        end

        self:_refreshGroupSize()
    end

    registerConnection(self.Window, frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        group:_refreshGroupLayout(false)
    end))

    task.defer(function()
        if frame.Parent then
            group:_refreshGroupLayout(true)
        end
    end)

    return group
end

