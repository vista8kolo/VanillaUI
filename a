    }, choices)

    element = setmetatable({
        Type = "Dropdown",
        Stateful = true,
        Title = title,
        Description = description,
        Object = root,
        Button = button,
        TitleLabel = titleLabel,
        DescriptionLabel = descriptionLabel,
        IconLabel = iconLabel,
        ValueLabel = valueLabel,
        Choices = choices,
        SearchBox = searchBox,
        ContentGroup = contentGroup,
        Values = {},
        OptionButtons = {},
        Multiple = multiple,
        Searchable = searchable,
        HeaderHeight = headerHeight,
        ChoicesY = choicesY,
        Open = false,
        Closing = false,
        Flag = option(options, {"flag", "Flag"}, nil),
        ForgetState = option(options, {"forgetState", "ForgetState"}, false) == true,
        value = {},
        DefaultValue = normalizeDropdownSelection(initial),
        Callback = option(options, {"callback", "Callback"}, nil),
    }, ElementMethods)
    element._refreshLayout = function()
        local newHeight = relayoutHeader()
        syncDropdownHeader(newHeight)
    end

    local refreshStyle = styleInteractiveSurface(self.Window, button, button, function()
        return element.Open or element.Closing
    end, {titleLabel, descriptionLabel, valueLabel})

    function element:_selected(optionValue)
        return table.find(self.value, tostring(optionValue)) ~= nil
    end

    function element:_callbackValue()
        return table.clone(self.value)
    end

    function element:_displayValue(value)
        return self.Window:_translate(tostring(value or ""))
    end

    function element:_updateSelectedLabel()
        if #self.value == 0 then
            self.ValueLabel.Text = self.Window:_translate("None")
        elseif not self.Multiple then
            self.ValueLabel.Text = self:_displayValue(self.value[1])
        elseif #self.value <= 2 then
            local translated = {}
            for _, selectedValue in ipairs(self.value) do
                translated[#translated + 1] = self:_displayValue(selectedValue)
            end
            self.ValueLabel.Text = table.concat(translated, ", ")
        else
            self.ValueLabel.Text = self:_displayValue(self.value[1]) .. " +" .. tostring(#self.value - 1)
        end
    end

    function element:_refreshOptionStyles()
        for optionValue, entry in pairs(self.OptionButtons) do
            entry.Refresh()
            entry.Check.Text = self:_selected(optionValue) and "✓" or ""
        end
    end

    function element:_refreshVisual()
        self:_updateSelectedLabel()
        self:_refreshOptionStyles()
        refreshStyle()
    end

    function element:Set(value, skipCallback, skipSave)
        local requested = normalizeDropdownSelection(value)
        local selected = {}
        for _, item in ipairs(requested) do
            if table.find(self.Values, item) and not table.find(selected, item) then
                selected[#selected + 1] = item
                if not self.Multiple then
                    break
                end
            end
        end
        local before = table.concat(self.value, "\0")
        local after = table.concat(selected, "\0")
        updateFlag(self, selected, skipSave)
        self:_refreshVisual()
        if before ~= after and not skipCallback then
            safeCall(self.Callback, self:_callbackValue())
        end
        return self
    end

    function element:SetOpen(open)
        local wasOpen = self.Open == true
        local requestedOpen = open == true
        local animationToken = (self.Object:GetAttribute("VanillaUIAnimationToken") or 0) + 1
        self.Object:SetAttribute("VanillaUIAnimationToken", animationToken)

        local visibleCount = 0
        for _, entry in pairs(self.OptionButtons) do
            if entry.Button.Visible then
                visibleCount = visibleCount + 1
            end
        end
        local contentHeight = math.min(196, math.max(0, visibleCount * 38 + math.max(0, visibleCount - 1) * 4))
        self.Choices.Size = UDim2.new(1, 0, 0, contentHeight)
        local target = requestedOpen and (self.ChoicesY + contentHeight) or self.HeaderHeight

        if requestedOpen then
            self.Open = true
            self.Closing = false
            self.Choices.Visible = true
            if self.SearchBox then self.SearchBox.Visible = true end
            if not self.ContentGroup.Visible then
                self.ContentGroup.GroupTransparency = 1
                self.ContentGroup.Visible = true
            end
            tween(self.Object, {Size = UDim2.new(1, 0, 0, target)})
            TweenService:Create(self.ContentGroup, STYLE.Tween, {GroupTransparency = 0}):Play()
            if not wasOpen then
                self.Window:_playSound("Open")
                self.Window:_beginFocus(self.Object, function()
                    if self.Open or self.Closing then self:SetOpen(false) end
                end, self.Title)
            end
            refreshStyle()
            return self
        end

        if not wasOpen and not self.Closing then
            refreshStyle(false)
            return self
        end

        self.Open = false
        self.Closing = true
        tween(self.Object, {Size = UDim2.new(1, 0, 0, target)})
        TweenService:Create(self.ContentGroup, STYLE.Tween, {GroupTransparency = 1}):Play()
        if wasOpen then
            self.Window:_playSound("Close")
            self.Window:_endFocus(self.Object)
        end
        refreshStyle()

        task.delay(STYLE.Tween.Time, function()
            if self.Object and self.Object.Parent
                and self.Object:GetAttribute("VanillaUIAnimationToken") == animationToken
                and not self.Open then
                self.ContentGroup.Visible = false
                self.ContentGroup.GroupTransparency = 0
                self.Choices.Visible = false
                if self.SearchBox then self.SearchBox.Visible = false end
                self.Closing = false
                refreshStyle(false)
            end
        end)
        return self
    end

    function element:_applyFilter(query)
        query = normalizeSearchText(query)
        for optionValue, entry in pairs(self.OptionButtons) do
            local sourceText = normalizeSearchText(optionValue)
            local translatedText = normalizeSearchText(self.Window:_translate(optionValue))
            entry.Button.Visible = query == "" or sourceText:find(query, 1, true) ~= nil or translatedText:find(query, 1, true) ~= nil
        end
        if self.Open then
            self:SetOpen(true)
        end
    end

    function element:RefreshOptions(newValues, keepSelection)
        self.Values = {}
        for _, value in ipairs(newValues or {}) do
            local text = tostring(value)
            if not table.find(self.Values, text) then
                self.Values[#self.Values + 1] = text
            end
        end
        for _, entry in pairs(self.OptionButtons) do
            destroy(entry.Button)
        end
        table.clear(self.OptionButtons)

        for index, optionValue in ipairs(self.Values) do
            local optionButton = create("TextButton", {
                Name = "Option",
                Size = UDim2.new(1, -2, 0, 38),
                LayoutOrder = index,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 5,
            }, self.Choices)
            local label = create("TextLabel", {
                Position = UDim2.fromOffset(10, 0),
                Size = UDim2.new(1, -42, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = self.Window:_translate(optionValue),
                TextColor3 = THEME.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.None,
                ZIndex = 6,
            }, optionButton)
            local check = create("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 0),
                Size = UDim2.fromOffset(20, 38),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = "",
                TextColor3 = Color3.fromRGB(20, 19, 17),
                TextSize = 12,
                ZIndex = 6,
            }, optionButton)
            local refresh = styleInteractiveSurface(self.Window, optionButton, optionButton, function()
                return element:_selected(optionValue)
            end, {label})
            self.OptionButtons[optionValue] = {Button = optionButton, Label = label, Check = check, Refresh = refresh, Source = optionValue}
            registerConnection(self.Window, optionButton.MouseButton1Click:Connect(function()
                if self.Multiple then
                    local selected = table.clone(self.value)
                    local found = table.find(selected, optionValue)
                    if found then
                        table.remove(selected, found)
                    else
                        selected[#selected + 1] = optionValue
                    end
                    self:Set(selected)
                else
                    self:Set({optionValue})
                    self:SetOpen(false)
                end
            end))
        end

        if not keepSelection then
            self:Set({}, true)
        else
            self:Set(self.value, true)
        end
        self:_applyFilter(self.SearchBox and self.SearchBox.Text or "")
        if self.Open and self.Window._focusOwner == self.Object then
            self.Window:_raiseFocusedObject(self.Object)
        end
        return self
    end

    element.Refresh = element.RefreshOptions

    function element:Add(value)
        local valuesCopy = table.clone(self.Values)
        local text = tostring(value)
        if not table.find(valuesCopy, text) then
            valuesCopy[#valuesCopy + 1] = text
            self:RefreshOptions(valuesCopy, true)
        end
        return self
    end

    function element:Remove(value)
        local valuesCopy = table.clone(self.Values)
        local index = table.find(valuesCopy, tostring(value))
        if index then
            table.remove(valuesCopy, index)
            self:RefreshOptions(valuesCopy, true)
        end
        return self
    end

    function element:_refreshLocalizedText()
        self.TitleLabel.Text = self.Window:_translate(self.SourceTitle or self.Title or "")
        if self.DescriptionLabel then
            self.DescriptionLabel.Text = self.Window:_translate(self.SourceDescription or self.Description or "")
        end
        if self.SearchBox then
            self.SearchBox.PlaceholderText = self.Window:_translate("Filter options...")
        end
        for optionValue, entry in pairs(self.OptionButtons) do
            if entry.Label then
                entry.Label.Text = self.Window:_translate(optionValue)
            end
        end
        self:_updateSelectedLabel()
        self:_applyFilter(self.SearchBox and self.SearchBox.Text or "")
    end

    registerConnection(self.Window, button.MouseButton1Click:Connect(function()
        if element.Locked then
            self.Window:Notify({Title = "Control locked", Content = element.LockReason or title, Duration = 3})
            return
        end
        element:SetOpen(not element.Open)
    end))
    if searchBox then
        registerConnection(self.Window, searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            element:_applyFilter(searchBox.Text)
        end))
    end

    registerElement(self, element, root)
    element:RefreshOptions(values, true)
    element:Set(initial, true, true)
    return element
end

function SectionMethods:CreateInput(options)
    options = type(options) == "table" and options or {}
    local title = tostring(option(options, {"name", "Name", "title", "Title"}, "Input"))
    local description = tostring(option(options, {"description", "Description", "desc", "Desc"}, "") or "")
    local default = tostring(option(options, {"value", "Value", "CurrentValue", "Default"}, "") or "")
    local placeholder = tostring(option(options, {"placeholder", "Placeholder", "PlaceholderText"}, "Type here...") or "")
    local height = description ~= "" and 72 or 44

    local root = create("Frame", {
        Name = "Input",
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = self:_nextOrder(),
    }, self.Parent)
    styleSurface(root, THEME.ButtonAlt)
    local titleLabel, descriptionLabel, iconLabel, resolvedHeight, relayoutHeader = createElementHeader(root, self.Window, options, 102, height)
    height = resolvedHeight

    local textBox = create("TextBox", {
        Name = "Field",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(90, 28),
        ClearTextOnFocus = false,
        Text = default,
        PlaceholderText = placeholder,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = THEME.Text,
        PlaceholderColor3 = THEME.SubText,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
    }, root)
    styleSurface(textBox, THEME.Button)
    create("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, textBox)

    local element = setmetatable({
        Type = "Input",
        Stateful = true,
        Title = title,
        Description = description,
        Object = root,
        TitleLabel = titleLabel,
        DescriptionLabel = descriptionLabel,
        IconLabel = iconLabel,
        TextBox = textBox,
        Flag = option(options, {"flag", "Flag"}, nil),
        ForgetState = option(options, {"forgetState", "ForgetState"}, false) == true,
        value = default,
        DefaultValue = default,
        NumbersOnly = option(options, {"numbersOnly", "NumbersOnly"}, false) == true,
        RemoveAfter = option(options, {"removeTextAfterFocusLost", "RemoveTextAfterFocusLost"}, false) == true,
        Callback = option(options, {"callback", "Callback"}, nil),
    }, ElementMethods)
    element._refreshLayout = relayoutHeader

    function element:Set(value, skipCallback, skipSave)
        value = tostring(value or "")
        if self.NumbersOnly then
            value = value:gsub("[^%d%.%-]", "")
        end
        local changed = self.value ~= value
        updateFlag(self, value, skipSave)
        self.TextBox.Text = value
        if changed and not skipCallback then
            safeCall(self.Callback, value)
        end
        return self
    end

    function element:Commit()
        self:Set(self.TextBox.Text)
        if self.RemoveAfter then
            self.TextBox.Text = ""
        end
        return self
    end

    element.SourcePlaceholder = placeholder
    function element:_refreshLocalizedText()
        self.TitleLabel.Text = self.Window:_translate(self.SourceTitle or self.Title or "")
        if self.DescriptionLabel then
            self.DescriptionLabel.Text = self.Window:_translate(self.SourceDescription or self.Description or "")
        end
        self.TextBox.PlaceholderText = self.Window:_translate(self.SourcePlaceholder or "Type here...")
    end

    registerConnection(self.Window, textBox.FocusLost:Connect(function()
        element:Commit()
    end))
    if element.NumbersOnly then
        registerConnection(self.Window, textBox:GetPropertyChangedSignal("Text"):Connect(function()
            local clean = textBox.Text:gsub("[^%d%.%-]", "")
            if clean ~= textBox.Text then
                textBox.Text = clean
            end
        end))
    end

    registerElement(self, element, root)
    return element
end

function SectionMethods:CreateKeybind(options)
    options = type(options) == "table" and options or {}
    local title = tostring(option(options, {"name", "Name", "title", "Title"}, "Keybind"))
    local description = tostring(option(options, {"description", "Description", "desc", "Desc"}, "") or "")
    local default = normalizeKey(option(options, {"value", "Value", "CurrentKeybind", "Default"}, Enum.KeyCode.Unknown), Enum.KeyCode.Unknown)
    local height = description ~= "" and 72 or 44

    local button = create("TextButton", {
        Name = "Keybind",
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = self:_nextOrder(),
        Text = "",
        AutoButtonColor = false,
    }, self.Parent)
    local titleLabel, descriptionLabel, iconLabel, resolvedHeight, relayoutHeader = createElementHeader(button, self.Window, options, 104, height)
    height = resolvedHeight
    local keyLabel = create("TextLabel", {
        Name = "Key",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(88, 24),
        BackgroundColor3 = THEME.ButtonAlt,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamMedium,
        Text = default.Name,
        TextColor3 = THEME.SubText,
        TextSize = 11,
        TextWrapped = false,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 4,
    }, button)
    addCorner(keyLabel, STYLE.Corner)
    addStroke(keyLabel, THEME.Border, STYLE.Stroke)

    local element = setmetatable({
        Type = "Keybind",
        Stateful = true,
        Title = title,
        Description = description,
        Object = button,
        TitleLabel = titleLabel,
        DescriptionLabel = descriptionLabel,
        IconLabel = iconLabel,
        KeyLabel = keyLabel,
        Flag = option(options, {"flag", "Flag"}, nil),
        ForgetState = option(options, {"forgetState", "ForgetState"}, false) == true,
        value = default,
        DefaultValue = default,
        HoldToInteract = option(options, {"holdToInteract", "HoldToInteract"}, false) == true,
        Callback = option(options, {"callback", "Callback"}, nil),
        OnChanged = option(options, {"onChanged", "OnChanged", "changed", "Changed"}, nil),
        Capturing = false,
    }, ElementMethods)
    element._refreshLayout = relayoutHeader

    local refreshStyle = styleInteractiveSurface(self.Window, button, button, function()
        return element.Capturing
    end, {titleLabel})

    function element:Refresh()
        self.KeyLabel.Text = self.Capturing and "..." or (self.value and self.value.Name or "None")
        refreshStyle()
    end

    function element:Set(value, skipCallback, skipSave)
        local key = normalizeKey(value, false)
        if not key then
            return self
        end
        local changed = self.value ~= key
        updateFlag(self, key, skipSave)
        self:Refresh()
        if changed and not skipCallback then
            safeCall(self.OnChanged, key)
        end
        return self
    end

    registerConnection(self.Window, button.MouseButton1Click:Connect(function()
        if element.Locked then
            self.Window:Notify({Title = "Control locked", Content = element.LockReason or title, Duration = 3})
            return
        end
        if self.Window._capturingKeybind and self.Window._capturingKeybind ~= element then
            self.Window._capturingKeybind.Capturing = false
            self.Window._capturingKeybind:Refresh()
        end
        element.Capturing = true
        self.Window._capturingKeybind = element
        element:Refresh()
    end))

    self.Window._keybinds[element] = true
    registerElement(self, element, button)
    element:Refresh()
    return element
end

