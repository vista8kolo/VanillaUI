    local function pulseSearchTarget(element)
        local object = element.Button or element.Object
        if not object or not object.Parent or not object:IsA("GuiObject") then
            return
        end

        local originalColor = object.BackgroundColor3
        local originalTransparency = object.BackgroundTransparency
        local originalTextColor = object:IsA("TextButton") and object.TextColor3 or nil
        tween(object, {
            BackgroundColor3 = THEME.Accent,
            BackgroundTransparency = STYLE.AcrylicActive,
        })
        if originalTextColor then
            tween(object, {TextColor3 = Color3.fromRGB(20, 19, 17)})
        end

        task.delay(0.38, function()
            if not object.Parent then
                return
            end
            tween(object, {
                BackgroundColor3 = originalColor,
                BackgroundTransparency = originalTransparency,
            })
            if originalTextColor then
                tween(object, {TextColor3 = originalTextColor})
            end
            local refresh = element._refreshVisual or element.Refresh
            if type(refresh) == "function" then
                task.defer(function()
                    if element.Object and element.Object.Parent then
                        refresh(element)
                    end
                end)
            end
        end)
    end

    local function focusSearchTarget(element)
        if not element or not element.Object or not element.Object.Parent then
            return
        end

        closeFloatingPanel(searchPanel)
        searchBox:ReleaseFocus()
        window:SetMenuVisibility(true)
        window:_showTab(element.Tab)

        task.defer(function()
            task.wait()
            local tab = element.Tab
            if tab and tab.Object and tab.Object.Parent then
                local y = element.Object.AbsolutePosition.Y - tab.Object.AbsolutePosition.Y + tab.Object.CanvasPosition.Y - 40
                local maxY = math.max(0, tab.Object.AbsoluteCanvasSize.Y - tab.Object.AbsoluteSize.Y)
                tab.Object.CanvasPosition = Vector2.new(0, math.clamp(y, 0, maxY))
            end
            pulseSearchTarget(element)
        end)
    end

