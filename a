    local function applyScale()
        local effective = math.clamp(userScale * responsiveScale, 0.72, 1.18)
        for _, scaleObject in ipairs(scaleObjects) do
            if scaleObject and scaleObject.Parent then
                scaleObject.Scale = effective
            end
        end
        for _, refresh in ipairs(settingRefreshers) do
            refresh()
        end
    end

    local function attachScale(target)
        local scaleObject = create("UIScale", {Scale = userScale * responsiveScale}, target)
        scaleObjects[#scaleObjects + 1] = scaleObject
        return scaleObject
    end

