function SectionMethods:CreateGroup(options)
    options = type(options) == "table" and options or {}
    local direction = string.lower(tostring(option(options, {"direction", "Direction"}, "column")))
    local isRow = direction == "row" or direction == "horizontal"
    local columns = math.clamp(math.floor(tonumber(option(options, {"columns", "Columns"}, 2)) or 2), 1, 4)
    local spacing = math.clamp(tonumber(option(options, {"spacing", "Spacing"}, 6)) or 6, 0, 16)

    local frame = create("Frame", {
        Name = "Group",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = isRow and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.Parent)

    local layout
    if isRow then
        layout = create("UIGridLayout", {
            CellPadding = UDim2.fromOffset(spacing, spacing),
            CellSize = UDim2.new(1 / columns, -spacing, 0, 56),
            FillDirectionMaxCells = columns,
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, frame)
    else
        layout = create("UIListLayout", {
            Padding = UDim.new(0, spacing),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, frame)
    end

    local group = setmetatable({
        Window = self.Window,
        Tab = self.Tab,
        Parent = frame,
        Object = frame,
        Title = tostring(option(options, {"name", "Name", "title", "Title"}, "Group")),
        Elements = {},
        IsGroup = true,
        Direction = isRow and "Row" or "Column",
        Columns = columns,
        Layout = layout,
    }, {__index = SectionMethods})

    function group:_refreshGroupSize()
        if self.Direction == "Row" then
            local rows = math.max(1, math.ceil(#self.Elements / self.Columns))
            self.Object.Size = UDim2.new(1, 0, 0, rows * 56 + math.max(0, rows - 1) * spacing)
        end
    end

    return group
end

