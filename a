local function normalizeSearchText(value)
    value = string.lower(tostring(value or ""))
    value = value:gsub("[áàäâ]", "a")
        :gsub("[éèëê]", "e")
        :gsub("[íìïî]", "i")
        :gsub("[óòöô]", "o")
        :gsub("[úùüû]", "u")
        :gsub("ñ", "n")
        :gsub("ç", "c")
        :gsub("[^%w%s%+%-_]", " ")
        :gsub("%s+", " ")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
    return value
end

local function expandSearchTerms(value)
    local terms = {}
    for term in normalizeSearchText(value):gmatch("%S+") do
        terms[#terms + 1] = SEARCH_ALIASES[term] or term
    end
    return terms
end

local function searchTextMatches(blob, terms)
    if #terms == 0 then
        return false
    end
    for _, term in ipairs(terms) do
        if not string.find(blob, term, 1, true) then
            return false
        end
    end
    return true
end

