    window.UIScale = uiScale

    for index, scale in ipairs({0.8, 0.9, 1.0, 1.1}) do
        local scaleButton = create("TextButton", {
            Size = UDim2.fromOffset(78, 30),
            LayoutOrder = index,
            Text = tostring(math.floor(scale * 100)) .. "%",
            ZIndex = 82,
        }, scaleHolder)
        styleButton(window, scaleButton, function()
            return math.abs(uiScale.Scale - scale) < 0.01
        end)
        registerConnection(window, scaleButton.MouseButton1Click:Connect(function()
            uiScale.Scale = scale
        end))
    end

    local helpPanel = createFloatingPanel(window, "HelpPanel", "AYUDA", UDim2.fromOffset(430, 245))
    attachScale(helpPanel)
    create("TextLabel", {
        Name = "Help",
        Position = UDim2.fromOffset(12, 43),
        Size = UDim2.new(1, -24, 1, -55),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = table.concat({
            "SUPR: mostrar u ocultar VanillaUI.",
            "MENÚ: mostrar u ocultar las categorías.",
            "La lupa filtra controles por nombre.",
            "La barra superior puede arrastrarse.",
            "",
            "API: CreateWindow, CreateTab, CreateSection,",
            "CreateButton, CreateToggle, CreateSlider,",
            "CreateDropdown, CreateParagraph y Notify.",
        }, "\n"),
        TextColor3 = THEME.SubText,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 81,
    }, helpPanel)

    local function hideFloatingPanels(except)
        for _, panel in ipairs({searchPanel, infoPanel, settingsPanel, helpPanel}) do
            if panel ~= except then
                panel.Visible = false
            end
        end
    end

    local function togglePanel(panel)
        local newState = not panel.Visible
        hideFloatingPanels(panel)
        panel.Visible = newState
    end

    registerConnection(window, menuButton.MouseButton1Click:Connect(function()
        window:SetMenuVisibility(not window.MenuVisible)
    end))
    registerConnection(window, searchButton.MouseButton1Click:Connect(function()
        togglePanel(searchPanel)
        if searchPanel.Visible then
            searchBox:CaptureFocus()
        end
    end))
    registerConnection(window, infoButton.MouseButton1Click:Connect(function()
        togglePanel(infoPanel)
    end))
    registerConnection(window, settingsButton.MouseButton1Click:Connect(function()
        togglePanel(settingsPanel)
    end))
    registerConnection(window, helpButton.MouseButton1Click:Connect(function()
        togglePanel(helpPanel)
    end))
    registerConnection(window, brandButton.MouseButton1Click:Connect(function()
        window:Notify({Title = "VanillaUI", Content = window.Title .. " · " .. window.Subtitle, Duration = 3})
    end))

    registerConnection(window, searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(searchBox.Text)
        for element in pairs(window._elements) do
            if element.Object and element.Object.Parent then
                local title = string.lower(element.Title or "")
                local matches = query == "" or string.find(title, query, 1, true) ~= nil
                element.Object.Visible = element.Visible ~= false and matches
            end
        end
    end))

    local dragging = false
    local dragStart
    local startPosition

    registerConnection(window, mainBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = mainBar.Position
        end
    end))

    registerConnection(window, UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            mainBar.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
            mainContainer.Position = UDim2.new(mainBar.Position.X.Scale, mainBar.Position.X.Offset, mainBar.Position.Y.Scale, mainBar.Position.Y.Offset + 50)
            for _, panel in ipairs({searchPanel, infoPanel, settingsPanel, helpPanel}) do
                panel.Position = UDim2.new(mainBar.Position.X.Scale, mainBar.Position.X.Offset, mainBar.Position.Y.Scale, mainBar.Position.Y.Offset + 44)
            end
        end
    end))

    registerConnection(window, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    registerConnection(window, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end
        if input.KeyCode == window.ToggleKey then
            window:Toggle()
        end
    end))

    local function updateResponsiveSize()
        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end
        local viewport = camera.ViewportSize
        local width = math.clamp(viewport.X - 30, 320, 1200)
        local height = math.clamp(viewport.Y - 105, 260, 700)
        mainContainer.Size = UDim2.fromOffset(width, height)

        if viewport.X < 560 then
            uiScale.Scale = math.min(uiScale.Scale, 0.82)
        end
    end

    updateResponsiveSize()
    if CurrentCamera then
        registerConnection(window, CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveSize))
    end
    registerConnection(window, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        CurrentCamera = Workspace.CurrentCamera
        updateResponsiveSize()
    end))

    window._cleanupFunction = function()
        window:Destroy()
    end
    GLOBAL_ENV[CLEANUP_KEY] = window._cleanupFunction

    return window
end

function VanillaUI:Notify(options)
    if self.ActiveWindow and not self.ActiveWindow.Destroyed then
        return self.ActiveWindow:Notify(options)
    end
end

local originalCreateWindow = VanillaUI.CreateWindow
function VanillaUI:CreateWindow(options)
    local window = originalCreateWindow(self, options)
    self.ActiveWindow = window
    return window
end

function VanillaUI:Destroy()
    if self.ActiveWindow then
        self.ActiveWindow:Destroy()
        self.ActiveWindow = nil
    end
end

VanillaUI.Theme = THEME
VanillaUI.Window = WindowMethods

return VanillaUI
