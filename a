function WindowMethods:Destroy()
    if self.Destroyed then
        return
    end
    self.Destroyed = true

    for _, callback in ipairs(self._cleanupCallbacks) do
        safeCall(callback)
    end

    for _, connection in ipairs(self._connections) do
        disconnect(connection)
    end

    destroy(self.ScreenGui)

    if GLOBAL_ENV[CLEANUP_KEY] == self._cleanupFunction then
        GLOBAL_ENV[CLEANUP_KEY] = nil
    end
end

