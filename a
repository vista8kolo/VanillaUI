local function normalizeLocaleId(value)
    local locale = string.lower(tostring(value or "en")):gsub("_", "-")
    locale = locale:gsub("%s+", "")
    if locale == "" then
        locale = "en"
    end
    return locale
end

local function copyTranslationPacks(customPacks)
    local output = {}
    local function merge(packs)
        if type(packs) ~= "table" then
            return
        end
        for localeId, entries in pairs(packs) do
            if type(entries) == "table" then
                local normalized = normalizeLocaleId(localeId)
                output[normalized] = output[normalized] or {}
                for source, translated in pairs(entries) do
                    if type(source) == "string" and translated ~= nil then
                        output[normalized][source] = tostring(translated)
                    end
                end
            end
        end
    end
    merge(BUILTIN_TRANSLATIONS)
    merge(customPacks)
    return output
end

