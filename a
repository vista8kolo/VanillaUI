    window._panelTweens = window._panelTweens or setmetatable({}, {__mode = "k"})

    local function nextPanelAnimationToken(panel)
        local token = (panel:GetAttribute("VanillaUIAnimationToken") or 0) + 1
        panel:SetAttribute("VanillaUIAnimationToken", token)
        return token
    end

    local function openFloatingPanel(panel)
        if not panel then return end
        local state = panel:GetAttribute("VanillaUIState")
        if state == "open" or state == "opening" then
            window:_refreshPanelButton(panel)
            return
        end

        local previous = window._panelTweens[panel]
        if previous then
            pcall(function() previous:Cancel() end)
            window._panelTweens[panel] = nil
        end

        window:_playSound("Open")
        window:_beginFocus(panel, function()
            if type(window._closeFloatingPanel) == "function" then
                window:_closeFloatingPanel(panel)
            end
        end, panel.Name)

        local token = nextPanelAnimationToken(panel)
        local target = floatingPanelTarget()
        panel:SetAttribute("VanillaUIState", "opening")
        panel:SetAttribute("VanillaUIAnimating", true)
        panel.Visible = true
        panel.Active = true
        panel.Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + 8)
        panel.GroupTransparency = 1
        window:_refreshPanelButton(panel)

        local animation = TweenService:Create(panel, STYLE.TweenPanel, {
            Position = target,
            GroupTransparency = 0,
        })
        window._panelTweens[panel] = animation
        local completed
        completed = animation.Completed:Connect(function()
            disconnect(completed)
            if window._panelTweens[panel] == animation then
                window._panelTweens[panel] = nil
            end
            if panel and panel.Parent and panel:GetAttribute("VanillaUIAnimationToken") == token then
                panel.GroupTransparency = 0
                panel:SetAttribute("VanillaUIState", "open")
                panel:SetAttribute("VanillaUIAnimating", false)
                window:_refreshPanelButton(panel)
            end
        end)
        animation:Play()
    end

    local function closeFloatingPanel(panel, immediate)
        if not panel then return end
        local state = panel:GetAttribute("VanillaUIState")
        if (not panel.Visible or state == "closed") and not immediate then
            window:_refreshPanelButton(panel)
            return
        end
        if state == "closing" and not immediate then
            return
        end

        local previous = window._panelTweens[panel]
        if previous then
            pcall(function() previous:Cancel() end)
            window._panelTweens[panel] = nil
        end

        window:_playSound("Close")
        window:_endFocus(panel, immediate == true)
        local token = nextPanelAnimationToken(panel)
        local target = floatingPanelTarget()
        panel:SetAttribute("VanillaUIState", "closing")
        panel:SetAttribute("VanillaUIAnimating", true)
        panel.Active = false

        if immediate then
            panel.GroupTransparency = 1
            panel.Visible = false
            panel.Position = target
            panel.GroupTransparency = 0
            panel.Active = true
            panel:SetAttribute("VanillaUIState", "closed")
            panel:SetAttribute("VanillaUIAnimating", false)
            window:_refreshPanelButton(panel)
            return
        end

        local animation = TweenService:Create(panel, STYLE.TweenPanel, {
            Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + 8),
            GroupTransparency = 1,
        })
        window._panelTweens[panel] = animation
        local completed
        completed = animation.Completed:Connect(function()
            disconnect(completed)
            if window._panelTweens[panel] == animation then
                window._panelTweens[panel] = nil
            end
            if panel and panel.Parent and panel:GetAttribute("VanillaUIAnimationToken") == token then
                panel.Visible = false
                panel.Position = target
                panel.GroupTransparency = 0
                panel.Active = true
                panel:SetAttribute("VanillaUIState", "closed")
                panel:SetAttribute("VanillaUIAnimating", false)
                window:_refreshPanelButton(panel)
            end
        end)
        animation:Play()
    end

    function window:_closeFloatingPanel(panel, immediate)
        closeFloatingPanel(panel, immediate)
    end

    local function hideFloatingPanels(except)
