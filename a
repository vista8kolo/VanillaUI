function TabMethods:Remove()
    local index = table.find(self.Window.Tabs, self)
    if index then
        table.remove(self.Window.Tabs, index)
        for tabIndex, tab in ipairs(self.Window.Tabs) do
            tab.Index = tabIndex
        end
    end
    destroy(self.Object)
    self.Window:_refreshTabPage()
end

function WindowMethods:_uniqueFlag(requested, element)
    local base = tostring(requested or "control")
    local candidate = base
    local index = 2
    while self._flagElements[candidate] and self._flagElements[candidate] ~= element do
        candidate = base .. "_" .. tostring(index)
        index = index + 1
    end
    return candidate
end

function WindowMethods:_refreshElementSearchText(element)
    if not element then
        return
    end
    local optionText = ""
    if type(element.Values) == "table" then
        optionText = table.concat(element.Values, " ")
    end
    element.SearchText = normalizeSearchText(table.concat({
        element.Title or "",
        element.Description or "",
        element.Type or "",
        element.Flag or "",
        optionText,
        element.Section and element.Section.Title or "",
        element.Tab and element.Tab.Title or "",
    }, " "))
    if element.Object then
        element.Object:SetAttribute("VanillaUISearchText", element.SearchText)
    end
end

function WindowMethods:Get(flag)
    return self.Flags[flag]
end

function WindowMethods:Set(flag, value, skipCallback)
    local element = self._flagElements[flag]
    if element and type(element.Set) == "function" then
        element:Set(value, skipCallback == true)
        return element
    end
    self.Flags[flag] = value
    VanillaUI.Flags[flag] = value
    self:_scheduleSave()
    return nil
end

function WindowMethods:GetElement(flag)
    return self._flagElements[flag]
end

function WindowMethods:ResetConfiguration(skipCallbacks)
    for flag, element in pairs(self._flagElements) do
        if element.DefaultValue ~= nil and type(element.Set) == "function" then
            element:Set(element.DefaultValue, skipCallbacks == true)
        else
            self.Flags[flag] = nil
            VanillaUI.Flags[flag] = nil
        end
    end
    self:_scheduleSave()
end

