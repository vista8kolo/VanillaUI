    local function nextPanelAnimationToken(panel)
        local token = (panel:GetAttribute("VanillaUIAnimationToken") or 0) + 1
        panel:SetAttribute("VanillaUIAnimationToken", token)
        return token
    end

    local function openFloatingPanel(panel)
        if not panel then
            return
        end
        local token = nextPanelAnimationToken(panel)
        local target = floatingPanelTarget()
        panel:SetAttribute("VanillaUIAnimating", true)
        panel.Visible = true
        panel.Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + 10)
        panel.BackgroundTransparency = 1
        local stroke = panel:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Transparency = 1 end
        TweenService:Create(panel, STYLE.TweenPanel, {
            Position = target,
            BackgroundTransparency = 0.04,
        }):Play()
        if stroke then
            TweenService:Create(stroke, STYLE.TweenPanel, {Transparency = STYLE.Stroke}):Play()
        end
        task.delay(STYLE.TweenPanel.Time, function()
            if panel and panel.Parent and panel:GetAttribute("VanillaUIAnimationToken") == token then
                panel:SetAttribute("VanillaUIAnimating", false)
            end
        end)
    end

    local function closeFloatingPanel(panel, immediate)
        if not panel or not panel.Visible then
            return
        end
        local token = nextPanelAnimationToken(panel)
        local target = floatingPanelTarget()
        panel:SetAttribute("VanillaUIAnimating", true)
        if immediate then
            panel.Visible = false
            panel.Position = target
            panel.BackgroundTransparency = 0.04
            panel:SetAttribute("VanillaUIAnimating", false)
            return
        end
        local stroke = panel:FindFirstChildOfClass("UIStroke")
        TweenService:Create(panel, STYLE.TweenPanel, {
            Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + 8),
            BackgroundTransparency = 1,
        }):Play()
        if stroke then
            TweenService:Create(stroke, STYLE.TweenPanel, {Transparency = 1}):Play()
        end
        task.delay(STYLE.TweenPanel.Time, function()
            if panel and panel.Parent and panel:GetAttribute("VanillaUIAnimationToken") == token then
                panel.Visible = false
                panel.Position = target
                panel.BackgroundTransparency = 0.04
                if stroke then stroke.Transparency = STYLE.Stroke end
                panel:SetAttribute("VanillaUIAnimating", false)
            end
        end)
    end

    function window:_closeFloatingPanel(panel, immediate)
        closeFloatingPanel(panel, immediate)
    end

    local function hideFloatingPanels(except)
