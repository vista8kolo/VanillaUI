        BackgroundColor3 = Color3.fromRGB(40, 37, 32),
        BorderSizePixel = 0,
        Active = true,
        ZIndex = 4,
    }, container)
    addCorner(bar, 3)

    local fill = create("Frame", {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = THEME.Accent,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, bar)
    addCorner(fill, 3)

    local knob = create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = THEME.CategoryTitle,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, bar)
    addCorner(knob, 6)
    addStroke(knob, THEME.Border, 0.08)

    local element = setmetatable({
        Type = "Slider",
        Stateful = true,
        Title = title,
        Description = description,
        Object = container,
        TitleLabel = titleLabel,
        DescriptionLabel = descriptionLabel,
        IconLabel = iconLabel,
        ValueLabel = valueLabel,
        Bar = bar,
        Fill = fill,
        Knob = knob,
        Flag = option(options, {"flag", "Flag"}, nil),
        ForgetState = option(options, {"forgetState", "ForgetState"}, false) == true,
        value = default,
        DefaultValue = default,
        Min = minimum,
        Max = maximum,
        Increment = increment,
        Suffix = suffix,
        Callback = option(options, {"callback", "Callback"}, nil),
    }, ElementMethods)
    element._refreshLayout = relayoutHeader

    function element:_round(value)
        local stepped = math.floor(((value - self.Min) / self.Increment) + 0.5) * self.Increment + self.Min
        return math.clamp(stepped, self.Min, self.Max)
    end

    function element:Refresh()
        local rangeValue = self.Max - self.Min
        local alpha = rangeValue == 0 and 0 or (self.value - self.Min) / rangeValue
        tween(self.Fill, {Size = UDim2.new(alpha, 0, 1, 0)})
        tween(self.Knob, {Position = UDim2.new(alpha, 0, 0.5, 0)})
        local incrementText = tostring(self.Increment)
        local decimals = #(incrementText:match("%.(%d+)") or "")
        self.ValueLabel.Text = string.format("%." .. tostring(decimals) .. "f%s", self.value, self.Suffix)
    end

    function element:Set(value, skipCallback, skipSave)
        value = tonumber(value)
        if not value then
            return self
        end
        value = self:_round(value)
        local changed = self.value ~= value
        updateFlag(self, value, skipSave)
        self:Refresh()
        if changed and not skipCallback then
            safeCall(self.Callback, value)
        end
        return self
    end

    function element:SetRange(newRange)
        if type(newRange) == "table" then
            self.Min = tonumber(newRange[1]) or self.Min
            self.Max = tonumber(newRange[2]) or self.Max
            if self.Max < self.Min then
                self.Min, self.Max = self.Max, self.Min
            end
            self:Set(self.value, true)
        end
        return self
    end

    function element:_setFromX(x)
        if self.Locked then
            return
        end
        local width = self.Bar.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local alpha = math.clamp((x - self.Bar.AbsolutePosition.X) / width, 0, 1)
        self:Set(self.Min + ((self.Max - self.Min) * alpha))
    end

    registerConnection(self.Window, bar.InputBegan:Connect(function(input)
        if element.Locked then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.Window._activeDragControl = element
            element:_setFromX(input.Position.X)
        end
    end))

    registerElement(self, element, container)
    element:Refresh()
    return element
end

