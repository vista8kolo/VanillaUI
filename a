    local function scoreSearchElement(element, terms)
        local title = normalizeSearchText((element.Title or "") .. " " .. window:_translate(element.SourceTitle or element.Title or ""))
        local description = normalizeSearchText((element.Description or "") .. " " .. window:_translate(element.SourceDescription or element.Description or ""))
        local flag = normalizeSearchText(element.Flag)
        local tabSource = element.Tab and (element.Tab.SourceTitle or element.Tab.Title) or ""
        local sectionSource = element.Section and (element.Section.SourceTitle or element.Section.Title) or ""
        local tab = normalizeSearchText(tabSource .. " " .. window:_translate(tabSource))
        local section = normalizeSearchText(sectionSource .. " " .. window:_translate(sectionSource))
        local optionsText = ""
        if type(element.Values) == "table" then
            local optionParts = {}
            for _, optionValue in ipairs(element.Values) do
                optionParts[#optionParts + 1] = tostring(optionValue)
                optionParts[#optionParts + 1] = window:_translate(tostring(optionValue))
            end
            optionsText = normalizeSearchText(table.concat(optionParts, " "))
        end

        local total = 0
        for _, term in ipairs(terms) do
            if title == term then
                total = total + 120
            elseif title:sub(1, #term) == term then
                total = total + 80
            elseif title:find(term, 1, true) then
                total = total + 55
            elseif flag:find(term, 1, true) then
                total = total + 38
            elseif section:find(term, 1, true) or tab:find(term, 1, true) then
                total = total + 24
            elseif optionsText:find(term, 1, true) then
                total = total + 18
            elseif description:find(term, 1, true) then
                total = total + 10
            else
                return nil
            end
        end
        return total
    end

    local function refreshSearchResults()
        if window.Destroyed or not searchResults.Parent then
            return
        end

        clearSearchResults()
        local terms = expandSearchTerms(searchBox.Text)
        if #terms == 0 then
            searchHint.Visible = true
            searchHintSource = "Type the name of a feature or setting."
            window:_applyTranslationBinding(searchHintBinding)
            return
        end

        local matches = {}
        for element in pairs(window._elements) do
            if element.Object and element.Object.Parent and element.Type ~= "Divider" and element.Visible ~= false then
                local score = scoreSearchElement(element, terms)
                if score then
                    matches[#matches + 1] = {Element = element, Score = score}
                end
            end
        end

        table.sort(matches, function(a, b)
            if a.Score == b.Score then
                return normalizeSearchText(a.Element.Title) < normalizeSearchText(b.Element.Title)
            end
            return a.Score > b.Score
        end)

        searchHint.Visible = #matches == 0
        searchHintSource = "No controls found."
        window:_applyTranslationBinding(searchHintBinding)

        window._firstSearchElement = matches[1] and matches[1].Element or nil
        local visualOrder = 1
        for index, match in ipairs(matches) do
            if index > 50 then
                break
            end
            visualOrder = visualOrder + 1
            createSearchResultButton(match.Element, visualOrder)
        end
    end
    window._refreshSearchResults = refreshSearchResults
    window.SearchPanel = searchPanel
    window.SearchInput = searchBox
    window.SearchResults = searchResults

    registerConnection(window, legalPlusButton.MouseButton1Click:Connect(function()
        if #window.Tabs <= PRIMARY_TAB_LIMIT then
            return
        end
        window.TabPage = window.TabPage == 1 and 2 or 1
        window:_refreshTabPage()
    end))

    registerConnection(window, menuButton.MouseButton1Click:Connect(function()
        window:SetMenuVisibility(not window.MenuVisible)
    end))
    registerConnection(window, searchButton.MouseButton1Click:Connect(function()
        togglePanel(searchPanel)
        if searchPanel.Visible then
            refreshSearchResults()
            searchBox:CaptureFocus()
        end
    end))
    registerConnection(window, infoButton.MouseButton1Click:Connect(function()
        togglePanel(infoPanel)
    end))
    registerConnection(window, settingsButton.MouseButton1Click:Connect(function()
        togglePanel(settingsPanel)
    end))
    registerConnection(window, helpButton.MouseButton1Click:Connect(function()
        togglePanel(helpPanel)
    end))
    local searchToken = 0
    registerConnection(window, searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        searchToken = searchToken + 1
        local token = searchToken
        task.delay(SEARCH_DEBOUNCE, function()
            if token == searchToken and not window.Destroyed then
                refreshSearchResults()
            end
        end)
    end))
    registerConnection(window, searchBox.FocusLost:Connect(function(enterPressed)
        if enterPressed and window._firstSearchElement then
            focusSearchTarget(window._firstSearchElement)
        end
    end))

    local dragging = false
    local dragStart
    local startPosition

    local function syncFloatingPositions()
        mainContainer.Position = UDim2.new(
            mainBar.Position.X.Scale,
            mainBar.Position.X.Offset,
            mainBar.Position.Y.Scale,
            mainBar.Position.Y.Offset + 50
        )
        for _, panel in ipairs(floatingPanels) do
            if panel:GetAttribute("VanillaUIAnimating") ~= true then
                panel.Position = UDim2.new(
                    mainBar.Position.X.Scale,
                    mainBar.Position.X.Offset,
                    mainBar.Position.Y.Scale,
                    mainBar.Position.Y.Offset + FLOATING_PANEL_OFFSET
                )
            end
        end
    end
    window._syncFloatingPositions = syncFloatingPositions

    local function clampMainBarPosition(position)
        local camera = Workspace.CurrentCamera
        if not camera then return position end
        local viewport = camera.ViewportSize
        local effectiveScale = window.UIScale.EffectiveScale
        local barWidth = math.max(180, mainBar.AbsoluteSize.X)
        local half = barWidth * 0.5
        local x = math.clamp(position.X.Offset, -viewport.X * 0.5 + half + 6, viewport.X * 0.5 - half - 6)
        local y = math.clamp(position.Y.Offset, 6, math.max(6, viewport.Y - 58))
        return UDim2.new(0.5, x, 0, y)
    end

    registerConnection(window, mainBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = mainBar.Position
        end
    end))

    registerConnection(window, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if window._activeDragControl then
            if type(window._activeDragControl._setFromPosition) == "function" then
                window._activeDragControl:_setFromPosition(input.Position)
            elseif type(window._activeDragControl._setFromX) == "function" then
                window._activeDragControl:_setFromX(input.Position.X)
            end
        end

        if dragging then
            local delta = input.Position - dragStart
            mainBar.Position = clampMainBarPosition(UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            ))
            syncFloatingPositions()
        end
    end))

    registerConnection(window, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            window._activeDragControl = nil
        end
        for keybind in pairs(window._heldKeybinds) do
            if input.KeyCode == keybind.value then
                window._heldKeybinds[keybind] = nil
                safeCall(keybind.Callback, false, input)
            end
        end
    end))

    registerConnection(window, UserInputService.InputBegan:Connect(function(input, processed)
        local capture = window._capturingKeybind
        if capture then
            if input.KeyCode == Enum.KeyCode.Escape then
                capture.Capturing = false
                window._capturingKeybind = nil
                capture:Refresh()
                return
            end
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                capture.Capturing = false
                window._capturingKeybind = nil
                capture:Set(input.KeyCode)
            end
            return
        end

        if processed then
            return
        end
        if input.KeyCode == window.ToggleKey then
            window:Toggle()
            return
        end

        for keybind in pairs(window._keybinds) do
            if not keybind.Locked and keybind.value == input.KeyCode then
                if keybind.HoldToInteract then
                    if not window._heldKeybinds[keybind] then
                        window._heldKeybinds[keybind] = true
                        safeCall(keybind.Callback, true, input)
                    end
                else
                    safeCall(keybind.Callback, input)
                end
            end
        end
    end))

    local cameraViewportConnection
    local function connectViewport(camera)
        disconnect(cameraViewportConnection)
        cameraViewportConnection = nil
        if camera then
            cameraViewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                if type(window._updateResponsiveSize) == "function" then
                    window._updateResponsiveSize()
                end
            end)
            window._connections[#window._connections + 1] = cameraViewportConnection
        end
    end

    local function updateResponsiveSize()
        local camera = Workspace.CurrentCamera
        if not camera then
            return
        end
        local viewport = camera.ViewportSize
        local responsive = 1
        if window.AutoScale then
            if viewport.X < 520 or viewport.Y < 420 then
                responsive = 0.82
            elseif viewport.X < 720 or viewport.Y < 520 then
                responsive = 0.88
            elseif viewport.X < 980 or viewport.Y < 640 then
                responsive = 0.94
            end
        end
        window._setResponsiveScale(responsive)

        local effectiveScale = window.UIScale.EffectiveScale
        local safeWidth = math.max(320, (viewport.X - 24) / effectiveScale)
        local safeHeight = math.max(260, (viewport.Y - 96) / effectiveScale)
        local width = math.clamp(safeWidth, 320, 1200)
        local height = math.clamp(safeHeight, 260, 700)
        mainContainer.Size = UDim2.fromOffset(width, height)

        local notificationWidth = viewport.X < 560 and 286 or DEFAULT_NOTIFICATION_WIDTH
        notificationHolder.Size = UDim2.fromOffset(notificationWidth, math.max(260, viewport.Y - 28))
        notificationHolder.Position = UDim2.new(1, -12, 1, -12)

        for _, panel in ipairs(floatingPanels) do
            local baseWidth = panel:GetAttribute("VanillaUIBaseWidth") or 380
            local baseHeight = panel:GetAttribute("VanillaUIBaseHeight") or 260
            local maxPanelWidth = math.max(290, (viewport.X - 24) / effectiveScale)
            local maxPanelHeight = math.max(220, (viewport.Y - 90) / effectiveScale)
            panel.Size = UDim2.fromOffset(
                math.min(baseWidth, maxPanelWidth),
                math.min(baseHeight, maxPanelHeight)
            )
        end

        mainBar.Position = clampMainBarPosition(mainBar.Position)
        syncFloatingPositions()
    end
    window._updateResponsiveSize = updateResponsiveSize

    updateResponsiveSize()
    connectViewport(Workspace.CurrentCamera)
    registerConnection(window, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        CurrentCamera = Workspace.CurrentCamera
        connectViewport(CurrentCamera)
        updateResponsiveSize()
    end))

    if not window._localeExplicit and LocalPlayer then
        registerConnection(window, LocalPlayer:GetPropertyChangedSignal("LocaleId"):Connect(function()
            window.Locale = normalizeLocaleId(LocalPlayer.LocaleId)
            window:RefreshTranslations()
        end))
    end

    window._cleanupFunction = function()
        window:Destroy()
    end
    GLOBAL_ENV[CLEANUP_KEY] = window._cleanupFunction
    window:_refreshTabPage()
    window:RefreshTranslations()

    return window
end

function VanillaUI:Notify(options)
    if self.ActiveWindow and not self.ActiveWindow.Destroyed then
        return self.ActiveWindow:Notify(options)
    end
end

local originalCreateWindow = VanillaUI.CreateWindow
function VanillaUI:CreateWindow(options)
    local window = originalCreateWindow(self, options)
    self.ActiveWindow = window
    return window
end

function VanillaUI:Destroy()
    if self.ActiveWindow then
        self.ActiveWindow:Destroy()
        self.ActiveWindow = nil
    end
end

VanillaUI.Theme = THEME
VanillaUI.Translations = BUILTIN_TRANSLATIONS
VanillaUI.Window = WindowMethods
VanillaUI.DiscordInvite = DISCORD_INVITE

return VanillaUI
