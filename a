    frame.Size = UDim2.new(1, 0, 0, math.max(48, bounds.Y + (title ~= "" and 35 or 18)))

    local element = setmetatable({
        Type = "Paragraph",
        Title = title,
        Object = frame,
        TitleLabel = titleLabel,
        ContentLabel = contentLabel,
    }, ElementMethods)

    function element:Set(contentOptions)
        if type(contentOptions) == "table" then
            if contentOptions.Title ~= nil then
                self.Title = tostring(contentOptions.Title)
