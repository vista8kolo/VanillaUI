function WindowMethods:_translate(source)
    if type(source) ~= "string" then
        return source
    end

    local localeId = normalizeLocaleId(self.Locale or "en")
    if type(self.Translator) == "function" then
        local ok, translated = safeCall(self.Translator, source, localeId)
        if ok and translated ~= nil then
            return tostring(translated)
        end
    end

    local translations = self.Translations or {}
    local exact = translations[localeId]
    if exact and exact[source] ~= nil then
        return tostring(exact[source])
    end

    local base = localeId:match("^([^-]+)")
    if base and base ~= localeId then
        local basePack = translations[base]
        if basePack and basePack[source] ~= nil then
            return tostring(basePack[source])
        end
    end

    return source
end

WindowMethods.Translate = WindowMethods._translate
WindowMethods.T = WindowMethods._translate

function WindowMethods:_applyTranslationBinding(binding)
    local object = binding and binding.Object
    if not object or not object.Parent then
        return false
    end

    local source = binding.Source
    if type(source) == "function" then
        local ok, value = safeCall(source)
        source = ok and value or ""
    end

    local translated = self:_translate(tostring(source or ""))
    if type(binding.Transform) == "function" then
        local ok, value = safeCall(binding.Transform, translated)
        if ok and value ~= nil then
            translated = value
        end
    end

    object[binding.Property or "Text"] = translated
    return true
end

function WindowMethods:_bindLocalized(object, property, source, transform)
    if not object then
        return nil
    end
    local binding = {
        Object = object,
        Property = property or "Text",
        Source = source,
        Transform = transform,
    }
    self._translationBindings[#self._translationBindings + 1] = binding
    self:_applyTranslationBinding(binding)
    return binding
end

function WindowMethods:RefreshTranslations()
    local kept = {}
    for _, binding in ipairs(self._translationBindings or {}) do
        if self:_applyTranslationBinding(binding) then
            kept[#kept + 1] = binding
        end
    end
    self._translationBindings = kept

    for _, tab in ipairs(self.Tabs or {}) do
        if type(tab._refreshLocalizedText) == "function" then
            tab:_refreshLocalizedText()
        end
        for _, section in ipairs(tab.Sections or {}) do
            if type(section._refreshLocalizedText) == "function" then
                section:_refreshLocalizedText()
            end
        end
    end

    for element in pairs(self._elements or {}) do
        if type(element._refreshLocalizedText) == "function" then
            element:_refreshLocalizedText()
        elseif type(element.Refresh) == "function" and element.Type == "Dropdown" then
            element:_refreshVisual()
        end
    end

    for _, tag in ipairs(self.Tags or {}) do
        if type(tag._refreshLocalizedText) == "function" then
            tag:_refreshLocalizedText()
        end
    end

    for _, refresh in ipairs(self._settingRefreshers or {}) do
        safeCall(refresh)
    end

    if type(self._refreshSearchResults) == "function" then
        self:_refreshSearchResults()
    end
    return self
end

function WindowMethods:SetLocale(localeId)
    self.Locale = normalizeLocaleId(localeId)
    self._localeExplicit = true
    self:RefreshTranslations()
    return self
end

function WindowMethods:GetLocale()
    return self.Locale
end

function WindowMethods:RegisterTranslations(packs)
    if type(packs) ~= "table" then
        return self
    end
    for localeId, entries in pairs(packs) do
        if type(entries) == "table" then
            local normalized = normalizeLocaleId(localeId)
            self.Translations[normalized] = self.Translations[normalized] or {}
            for source, translated in pairs(entries) do
                if type(source) == "string" and translated ~= nil then
                    self.Translations[normalized][source] = tostring(translated)
                end
            end
        end
    end
    self:RefreshTranslations()
    return self
end

function WindowMethods:SetTranslator(translator)
    self.Translator = type(translator) == "function" and translator or nil
    self:RefreshTranslations()
    return self
end

function ElementMethods:SetVisible(visible)
    self.Visible = visible ~= false
    if self.Object then
        self.Object.Visible = self.Visible
    end
    if self.Window and type(self.Window._refreshSearchResults) == "function" then
        task.defer(self.Window._refreshSearchResults)
    end
    return self
end

function ElementMethods:SetTitle(title)
    self.SourceTitle = tostring(title or "")
    self.Title = self.SourceTitle
    self.name = self.Title
    self.Name = self.Title
    if type(self._refreshLocalizedText) == "function" then
        self:_refreshLocalizedText()
    elseif self.TitleLabel then
        self.TitleLabel.Text = self.Window and self.Window:_translate(self.SourceTitle) or self.SourceTitle
    elseif self.Object and self.Object:IsA("TextButton") then
        self.Object.Text = self.Window and self.Window:_translate(self.SourceTitle) or self.SourceTitle
    end
    if self.Window then
        self.Window:_refreshElementSearchText(self)
    end
    return self
end

ElementMethods.SetName = ElementMethods.SetTitle

function ElementMethods:SetDescription(description)
    self.SourceDescription = tostring(description or "")
    self.Description = self.SourceDescription
    self.description = self.Description
    if type(self._refreshLocalizedText) == "function" then
        self:_refreshLocalizedText()
    elseif self.DescriptionLabel then
        self.DescriptionLabel.Text = self.Window and self.Window:_translate(self.SourceDescription) or self.SourceDescription
        self.DescriptionLabel.Visible = self.SourceDescription ~= ""
    end
    if self.Window then
        self.Window:_refreshElementSearchText(self)
    end
    return self
end

