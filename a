        }, panel)

        registerConnection(self.Window, alphaCapture.InputBegan:Connect(function(input)
            if element.Locked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local drag = {}
                function drag:_setFromPosition(position)
                    local width = alphaBar.AbsoluteSize.X
                    if width <= 0 then return end
                    local value = math.clamp((position.X - alphaBar.AbsolutePosition.X) / width, 0, 1)
                    element:SetTransparency(value)
                end
                self.Window._activeDragControl = drag
                drag:_setFromPosition(input.Position)
            end
        end))
    end

    element.AlphaBar = alphaBar
    element.AlphaGradient = alphaGradient
    element.AlphaSelector = alphaSelector
    element.AlphaValue = alphaValue

    local function beginFieldDrag(input)
        if element.Locked then return end
        local drag = {}
        function drag:_setFromPosition(position)
            local size = colorField.AbsoluteSize
            if size.X <= 0 or size.Y <= 0 then return end
            local s = math.clamp((position.X - colorField.AbsolutePosition.X) / size.X, 0, 1)
            local v = 1 - math.clamp((position.Y - colorField.AbsolutePosition.Y) / size.Y, 0, 1)
            element:SetHSV(element.Hue, s, v)
        end
        self.Window._activeDragControl = drag
        drag:_setFromPosition(input.Position)
    end

    local function beginHueDrag(input)
        if element.Locked then return end
        local drag = {}
        function drag:_setFromPosition(position)
            local height = hueBar.AbsoluteSize.Y
            if height <= 0 then return end
            local h = math.clamp((position.Y - hueBar.AbsolutePosition.Y) / height, 0, 1)
            element:SetHSV(h, element.Saturation, element.Brightness)
        end
        self.Window._activeDragControl = drag
        drag:_setFromPosition(input.Position)
    end

    registerConnection(self.Window, fieldCapture.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            beginFieldDrag(input)
        end
    end))
    registerConnection(self.Window, hueCapture.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            beginHueDrag(input)
        end
    end))

    function element:Refresh()
        local color = self.value
        self.Swatch.BackgroundColor3 = color
        self.HexLabel.Text = colorToHex(color)
        self.HexLabel.TextColor3 = contrastColor(color)
        self.Preview.BackgroundColor3 = color
        self.ColorField.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
        self.FieldSelector.Position = UDim2.fromScale(self.Saturation, 1 - self.Brightness)
        self.FieldSelector.BackgroundColor3 = color
        self.HueSelector.Position = UDim2.new(0.5, 0, self.Hue, 0)
        if self.HexBox and not self.HexBox:IsFocused() then
            self.HexBox.Text = colorToHex(color)
        end
        if self.AlphaGradient then
            self.AlphaGradient.BackgroundColor3 = color
        end
        if self.AlphaSelector then
            self.AlphaSelector.Position = UDim2.new(self.transparency, 0, 0.5, 0)
        end
        if self.AlphaValue then
            self.AlphaValue.Text = tostring(math.floor(self.transparency * 100 + 0.5)) .. "%"
        end
        refreshStyle()
    end

    function element:Set(value, skipCallback, skipSave)
        local requestedTransparency
        local colorValue = value
        if type(value) == "table" then
            colorValue = value.Color or value.color or value.Value or value.value or value[1]
            requestedTransparency = value.Transparency or value.transparency or value.Alpha or value.alpha
        end

        local color = parseHexColor(colorValue)
        if not color then
            return self
        end

        local oldColor = self.value
        local oldTransparency = self.transparency
        local h, s, v = color:ToHSV()
        if s > 0.0001 then
            self.Hue = h
        end
        self.Saturation = s
        self.Brightness = v
        if requestedTransparency ~= nil and self.AllowTransparency then
            self.transparency = math.clamp(tonumber(requestedTransparency) or self.transparency, 0, 1)
            self.Transparency = self.transparency
        end

        updateFlag(self, color, skipSave)
        self:Refresh()
        if (oldColor ~= color or oldTransparency ~= self.transparency) and not skipCallback then
            safeCall(self.Callback, color, self.transparency)
        end
        return self
    end

    function element:SetHSV(h, s, v, skipCallback, skipSave)
        self.Hue = math.clamp(tonumber(h) or self.Hue, 0, 1)
        self.Saturation = math.clamp(tonumber(s) or self.Saturation, 0, 1)
        self.Brightness = math.clamp(tonumber(v) or self.Brightness, 0, 1)
        local color = Color3.fromHSV(self.Hue, self.Saturation, self.Brightness)
        local oldColor = self.value
        updateFlag(self, color, skipSave)
        self:Refresh()
        if oldColor ~= color and not skipCallback then
            safeCall(self.Callback, color, self.transparency)
        end
        return self
    end

    function element:SetTransparency(value, skipCallback, skipSave)
        if not self.AllowTransparency then
            return self
        end
        local transparency = math.clamp(tonumber(value) or self.transparency, 0, 1)
        local changed = transparency ~= self.transparency
        self.transparency = transparency
        self.Transparency = transparency
        if not skipSave and not self.ForgetState then
            self.Window:_scheduleSave()
        end
        self:Refresh()
        if changed and not skipCallback then
            safeCall(self.Callback, self.value, transparency)
        end
        return self
    end

    function element:GetTransparency()
        return self.transparency
    end

    function element:SetOpen(open)
        self.Open = open == true
        local targetHeight = self.Open and (headerHeight + panelHeight + 5) or headerHeight
        if self.Open then
            self.Panel.Visible = true
        end
        tween(self.Object, {Size = UDim2.new(1, 0, 0, targetHeight)})
        if not self.Open then
            task.delay(STYLE.Tween.Time, function()
                if not self.Open and self.Panel then
                    self.Panel.Visible = false
                end
            end)
        end
        refreshStyle()
        return self
    end

    function element:_refreshLocalizedText()
        self.TitleLabel.Text = self.Window:_translate(self.SourceTitle or self.Title or "")
        if self.DescriptionLabel then
            self.DescriptionLabel.Text = self.Window:_translate(self.SourceDescription or self.Description or "")
        end
    end

    registerConnection(self.Window, hexBox.FocusLost:Connect(function()
        local parsed = parseHexColor(hexBox.Text)
        if parsed then
            element:Set(parsed)
        else
            hexBox.Text = colorToHex(element.value)
        end
    end))

    registerConnection(self.Window, button.MouseButton1Click:Connect(function()
        if element.Locked then
            self.Window:Notify({Title = "Control locked", Content = element.LockReason or title, Duration = 3})
            return
        end
        element:SetOpen(not element.Open)
    end))

    registerElement(self, element, root)
    if option(options, {"locked", "Locked"}, false) == true then
        element:Lock(option(options, {"lockReason", "LockReason"}, nil))
    end
    element:Refresh()
    return element
end
function SectionMethods:CreateStat(options)
    options = type(options) == "table" and options or {name = tostring(options)}
    local title = tostring(option(options, {"name", "Name", "title", "Title"}, "Stat"))
    local description = tostring(option(options, {"description", "Description", "desc", "Desc"}, "") or "")
    local default = option(options, {"value", "Value", "Default"}, 0)
    local height = description ~= "" and 72 or 44

    local root = create("Frame", {
        Name = "Stat",
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = self:_nextOrder(),
    }, self.Parent)
    styleSurface(root, THEME.ButtonAlt)
    local titleLabel, descriptionLabel, iconLabel = createElementHeader(root, options, 88, height)
    local valueLabel = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(78, 24),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = tostring(default),
        TextColor3 = THEME.Accent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextWrapped = true,
        TextTruncate = Enum.TextTruncate.None,
        ZIndex = 4,
    }, root)

    local element = setmetatable({
        Type = "Stat",
        Title = title,
        Description = description,
        Object = root,
        TitleLabel = titleLabel,
        DescriptionLabel = descriptionLabel,
        IconLabel = iconLabel,
        ValueLabel = valueLabel,
        value = default,
        Suffix = tostring(option(options, {"suffix", "Suffix"}, "") or ""),
        Formatter = option(options, {"format", "Format", "formatter", "Formatter"}, nil),
        AnimationToken = 0,
        ForgetState = true,
    }, ElementMethods)

    local function format(value)
        if type(element.Formatter) == "function" then
            local ok, result = safeCall(element.Formatter, value)
            if ok and result ~= nil then
                return tostring(result)
            end
        end
        return tostring(value) .. element.Suffix
    end

    function element:Set(value, instant)
        local oldValue = self.value
        mirrorValueFields(self, value)
        self.AnimationToken = self.AnimationToken + 1
        local token = self.AnimationToken
        if not instant and type(oldValue) == "number" and type(value) == "number" then
            task.spawn(function()
                local steps = 10
                for step = 1, steps do
                    if token ~= self.AnimationToken or not self.ValueLabel.Parent then
                        return
                    end
                    local alpha = step / steps
                    self.ValueLabel.Text = format(oldValue + ((value - oldValue) * alpha))
                    task.wait(0.018)
                end
            end)
        else
            self.ValueLabel.Text = format(value)
        end
        return self
    end

    registerElement(self, element, root)
    element:Set(default, true)
    return element
end

