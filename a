local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return true
    end

    local ok, result = pcall(callback, ...)
    if not ok then
        warn("[VanillaUI] Callback error: " .. tostring(result))
    end
    return ok, result
end

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function destroy(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

local function shallowCopy(source)
    local output = {}
    for key, value in pairs(source or {}) do
        output[key] = value
    end
    return output
end

local function mergeInto(base, overrides)
    local output = shallowCopy(base)
    if type(overrides) == "table" then
        for key, value in pairs(overrides) do
            output[key] = value
        end
    end
    return output
end

local function formatSessionTime(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local remaining = seconds % 60
    if hours > 0 then
        return string.format("%02d:%02d:%02d", hours, minutes, remaining)
    end
    return string.format("%02d:%02d", minutes, remaining)
end

local function resolveSoundAsset(value)
    if type(value) == "number" then
        return "rbxassetid://" .. tostring(value)
    end
    if type(value) == "string" and value ~= "" then
        return value
    end
    if type(value) == "table" then
        return resolveSoundAsset(value.Id or value.ID or value.SoundId or value.SoundID or value.Asset)
    end
    return nil
end

local function create(className, properties, parent)
    local instance = Instance.new(className)
    for property, value in pairs(properties or {}) do
        instance[property] = value
    end
    instance.Parent = parent
    return instance
end

local function addCorner(object, radius)
    local corner = object:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or STYLE.Corner)
    corner.Parent = object
    return corner
end

local function addStroke(object, color, transparency)
    local stroke = object:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or THEME.Border
    stroke.Thickness = 1
    stroke.Transparency = transparency == nil and STYLE.Stroke or transparency
    stroke.Parent = object
    return stroke
end

local function styleSurface(object, background, radius)
    object.BackgroundColor3 = background or THEME.Button
    object.BackgroundTransparency = STYLE.Acrylic
    object.BorderSizePixel = 0
    object.ClipsDescendants = true
    addCorner(object, radius)
    addStroke(object, THEME.Border, STYLE.Stroke)
end

local function tween(object, properties)
    local animation = TweenService:Create(object, STYLE.Tween, properties)
    animation:Play()
    return animation
end

local function estimateControlWidth(window, object)
    local width = object and object.AbsoluteSize.X or 0
    if width and width >= MIN_CONTROL_WIDTH then
        return width
    end
    if window and window._singleTabMode and window.TabHolder and window.TabHolder.AbsoluteSize.X >= MIN_CONTROL_WIDTH then
        return math.max(MIN_CONTROL_WIDTH, window.TabHolder.AbsoluteSize.X - 8)
    end
    return math.max(MIN_CONTROL_WIDTH, tonumber(window and window.TabWidth) or 180)
end

local function measureWrappedHeight(text, font, textSize, width, maxLines)
    text = tostring(text or "")
    if text == "" then
        return 0
    end
    width = math.max(36, tonumber(width) or 120)
    local ok, bounds = pcall(TextService.GetTextSize, TextService, text, textSize, font, Vector2.new(width, 1000))
    local lineHeight = math.max(1, math.ceil(textSize * 1.22))
    local measured = ok and math.ceil(bounds.Y) or lineHeight
    local lineLimit = math.max(1, tonumber(maxLines) or 1) * lineHeight
    return math.clamp(measured, lineHeight, lineLimit)
end

local function normalizeKey(value, fallback)
    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
        return value
    end
    if type(value) == "string" and Enum.KeyCode[value] then
        return Enum.KeyCode[value]
    end
    if fallback == false then
        return nil
    end
    return fallback or Enum.KeyCode.Delete
end

local function normalizeTitle(options, fallback)
    if type(options) == "string" then
        return options
    end
    if type(options) == "table" then
        return options.Title or options.Name or fallback
    end
    return fallback
end

local function option(options, names, fallback)
    if type(options) ~= "table" then
        return fallback
    end
    for _, name in ipairs(names) do
        local value = options[name]
        if value ~= nil then
            return value
        end
    end
    return fallback
end

local function deriveFlagFromName(value)
    local flag = string.lower(tostring(value or ""))
    flag = flag:gsub("[áàäâ]", "a"):gsub("[éèëê]", "e"):gsub("[íìïî]", "i")
        :gsub("[óòöô]", "o"):gsub("[úùüû]", "u"):gsub("ñ", "n"):gsub("ç", "c")
    flag = flag:gsub("[%s%-]+", "_"):gsub("[^%w_]", ""):gsub("_+", "_")
    flag = flag:gsub("^_+", ""):gsub("_+$", "")
    if flag == "" then
        flag = "control"
    end
    return flag
end

local function resolveIcon(icon)
    if type(icon) == "number" then
        return "rbxassetid://" .. tostring(icon)
    end
    if type(icon) == "string" and icon ~= "" then
        if icon:find("rbxasset", 1, true) or icon:find("http", 1, true) or icon:find("asset", 1, true) then
            return icon
        end
    end
