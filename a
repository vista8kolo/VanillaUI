function WindowMethods:Set(flag, value, skipCallback)
    local element = self._flagElements[flag]
    if element and type(element.Set) == "function" then
        element:Set(value, skipCallback == true)
        return element
    end
    self.Flags[flag] = value
    VanillaUI.Flags[flag] = value
    self:_scheduleSave()
    return nil
end

