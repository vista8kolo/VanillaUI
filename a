function WindowMethods:_nextTabOrder()
    self._tabOrder = self._tabOrder + 1
    return self._tabOrder
end

function WindowMethods:_refreshTabPage()
    local hasSecondaryTabs = #self.Tabs > PRIMARY_TAB_LIMIT
    self.TabPage = hasSecondaryTabs and math.clamp(self.TabPage or 1, 1, 2) or 1

    if self.LegalPlusButton then
        self.LegalPlusButton.Visible = hasSecondaryTabs
    end

    for index, tab in ipairs(self.Tabs) do
        local visible
        if not hasSecondaryTabs or self.TabPage == 1 then
            visible = index <= PRIMARY_TAB_LIMIT
        else
            visible = index > PRIMARY_TAB_LIMIT
        end
        tab.Object.Visible = visible and tab.ManualVisible ~= false
    end

    if self.TabHolder then
        self.TabHolder.CanvasPosition = Vector2.new(0, 0)
    end

    if type(self._refreshLegalPlusButton) == "function" then
        self._refreshLegalPlusButton(false)
    end
end

function WindowMethods:_showTab(tab)
    if not tab then
        return
    end

    local index = tab.Index
    if not index then
        for tabIndex, currentTab in ipairs(self.Tabs) do
            if currentTab == tab then
                index = tabIndex
                break
            end
        end
    end

    if index and #self.Tabs > PRIMARY_TAB_LIMIT then
        self.TabPage = index <= PRIMARY_TAB_LIMIT and 1 or 2
        self:_refreshTabPage()
    end
end

function WindowMethods:_scheduleSave()
    if not self.ConfigurationSaving.Enabled or self._loadingConfiguration then
        return
    end
    self._saveToken = self._saveToken + 1
    local token = self._saveToken
    task.delay(0.25, function()
        if not self.Destroyed and token == self._saveToken then
            self:SaveConfiguration()
        end
    end)
end

function WindowMethods:_configurationPath()
    local folder = sanitizeFileName(self.ConfigurationSaving.FolderName or "VanillaUI")
    local file = sanitizeFileName(self.ConfigurationSaving.FileName or self.Title)
    return folder, folder .. "/" .. file .. ".json"
end

function WindowMethods:SaveConfiguration()
    if not self.ConfigurationSaving.Enabled then
        return false, "ConfigurationSaving is disabled"
    end
    if type(writefile) ~= "function" then
        return false, "writefile is unavailable"
    end

    local folder, path = self:_configurationPath()
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then
            makefolder(folder)
        elseif type(makefolder) == "function" then
            makefolder(folder)
        end
    end)

    local data = {}
    for flag, value in pairs(self.Flags) do
        local serialized = serializeValue(value)
        if serialized ~= nil then
            data[flag] = serialized
        end
    end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then
        return false, encoded
    end

    local writeOk, writeError = pcall(writefile, path, encoded)
    return writeOk, writeError
end

function WindowMethods:LoadConfiguration()
    if not self.ConfigurationSaving.Enabled then
        return false, "ConfigurationSaving is disabled"
    end
    if type(readfile) ~= "function" then
        return false, "readfile is unavailable"
    end

    local _, path = self:_configurationPath()
    if type(isfile) == "function" and not isfile(path) then
        return false, "Configuration not found"
    end

    local readOk, content = pcall(readfile, path)
    if not readOk or type(content) ~= "string" then
        return false, content
    end

    local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, content)
    if not decodeOk or type(data) ~= "table" then
        return false, data
    end

    self._loadedValues = data
    self._loadingConfiguration = true
    for flag, value in pairs(data) do
        local element = self._flagElements[flag]
        if element and type(element.Set) == "function" then
            element:Set(deserializeValue(value), false, true)
        end
    end
    self._loadingConfiguration = false
    return true
end

