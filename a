local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return true
    end

    local ok, result = pcall(callback, ...)
    if not ok then
        warn("[VanillaUI] Callback error: " .. tostring(result))
    end
    return ok, result
end

local function disconnect(connection)
    if connection then
        pcall(function()
            connection:Disconnect()
        end)
    end
end

local function destroy(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

local function create(className, properties, parent)
    local instance = Instance.new(className)
    for property, value in pairs(properties or {}) do
        instance[property] = value
    end
    instance.Parent = parent
    return instance
end

local function addCorner(object, radius)
    local corner = object:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or STYLE.Corner)
    corner.Parent = object
    return corner
end

local function addStroke(object, color, transparency)
    local stroke = object:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or THEME.Border
    stroke.Thickness = 1
    stroke.Transparency = transparency == nil and STYLE.Stroke or transparency
    stroke.Parent = object
    return stroke
end

local function styleSurface(object, background, radius)
    object.BackgroundColor3 = background or THEME.Button
    object.BackgroundTransparency = STYLE.Acrylic
    object.BorderSizePixel = 0
    object.ClipsDescendants = true
    addCorner(object, radius)
    addStroke(object, THEME.Border, STYLE.Stroke)
end

local function tween(object, properties)
    local animation = TweenService:Create(object, STYLE.Tween, properties)
    animation:Play()
    return animation
end

local function normalizeKey(value, fallback)
    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
        return value
    end
    if type(value) == "string" and Enum.KeyCode[value] then
        return Enum.KeyCode[value]
    end
    if fallback == false then
        return nil
    end
    return fallback or Enum.KeyCode.Delete
end

local function normalizeTitle(options, fallback)
    if type(options) == "string" then
        return options
    end
    if type(options) == "table" then
        return options.Title or options.Name or fallback
    end
    return fallback
end

local function option(options, names, fallback)
    if type(options) ~= "table" then
        return fallback
    end
    for _, name in ipairs(names) do
        local value = options[name]
        if value ~= nil then
            return value
        end
    end
    return fallback
end

local function deriveFlagFromName(value)
    local flag = string.lower(tostring(value or ""))
    flag = flag:gsub("[áàäâ]", "a"):gsub("[éèëê]", "e"):gsub("[íìïî]", "i")
        :gsub("[óòöô]", "o"):gsub("[úùüû]", "u"):gsub("ñ", "n"):gsub("ç", "c")
    flag = flag:gsub("[%s%-]+", "_"):gsub("[^%w_]", ""):gsub("_+", "_")
    flag = flag:gsub("^_+", ""):gsub("_+$", "")
    if flag == "" then
        flag = "control"
    end
    return flag
end

local function resolveIcon(icon)
    if type(icon) == "number" then
        return "rbxassetid://" .. tostring(icon)
    end
    if type(icon) == "string" and icon ~= "" then
        if icon:find("rbxasset", 1, true) or icon:find("http", 1, true) or icon:find("asset", 1, true) then
            return icon
        end
    end
    return nil
end

local function contrastColor(color)
    local luminance = (color.R * 0.299) + (color.G * 0.587) + (color.B * 0.114)
    return luminance > 0.62 and Color3.fromRGB(20, 19, 17) or Color3.fromRGB(245, 241, 232)
end

local function parseHexColor(value)
    if typeof(value) == "Color3" then
        return value
    end
    if type(value) ~= "string" then
        return nil
    end
    local hex = value:gsub("#", ""):gsub("0x", "")
    if #hex == 3 then
        hex = hex:sub(1, 1):rep(2) .. hex:sub(2, 2):rep(2) .. hex:sub(3, 3):rep(2)
    end
    if not hex:match("^%x%x%x%x%x%x$") then
        return nil
    end
    local ok, color = pcall(Color3.fromHex, hex)
    return ok and color or nil
end

local function colorToHex(color)
    return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function resolveGuiParent()
    local parent

    pcall(function()
        if type(gethui) == "function" then
            parent = gethui()
        end
    end)

    if parent then
        return parent
    end

    if LocalPlayer then
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
        if playerGui then
            return playerGui
        end
    end

    return CoreGui
end

local function sanitizeFileName(value)
    value = tostring(value or "VanillaUI")
    value = value:gsub("[^%w%-%_ ]", "")
    value = value:gsub("%s+", "_")
    if value == "" then
        value = "VanillaUI"
    end
    return value
end

local function serializeValue(value)
    local valueType = typeof(value)
    if valueType == "boolean" or valueType == "number" or valueType == "string" then
        return value
    end
    if valueType == "EnumItem" then
        return {__vanillaType = "EnumItem", value = tostring(value)}
    end
    if valueType == "Color3" then
        return {__vanillaType = "Color3", value = colorToHex(value)}
    end
    if valueType == "table" then
        local output = {}
        for key, item in pairs(value) do
            local serialized = serializeValue(item)
            if serialized ~= nil then
                output[key] = serialized
            end
        end
        return output
    end
    return nil
end

local function deserializeValue(value)
    if type(value) ~= "table" then
        return value
    end
    if value.__vanillaType == "Color3" then
        return parseHexColor(value.value) or Color3.new(1, 1, 1)
    end
    if value.__vanillaType == "EnumItem" and type(value.value) == "string" then
        local enumName, itemName = value.value:match("^Enum%.([^.]+)%.(.+)$")
        if enumName and itemName and Enum[enumName] then
            return Enum[enumName][itemName]
        end
        return value.value
    end
    local output = {}
    for key, item in pairs(value) do
        output[key] = deserializeValue(item)
    end
    return output
end

