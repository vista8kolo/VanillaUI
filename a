function SectionMethods:CreateSlider(options)
    options = type(options) == "table" and options or {}
    local title = tostring(option(options, {"name", "Name", "title", "Title"}, "Slider"))
    local description = tostring(option(options, {"description", "Description", "desc", "Desc"}, "") or "")
    local range = option(options, {"range", "Range"}, nil)
    local minimum = tonumber(range and range[1] or option(options, {"min", "Min"}, 0)) or 0
    local maximum = tonumber(range and range[2] or option(options, {"max", "Max"}, 100)) or 100
    if maximum < minimum then
        minimum, maximum = maximum, minimum
    end
    local increment = math.abs(tonumber(option(options, {"increment", "Increment", "step", "Step"}, 1)) or 1)
    if increment == 0 then
        increment = 1
    end
    local suffix = tostring(option(options, {"suffix", "Suffix"}, "") or "")
    local default = tonumber(option(options, {"value", "Value", "CurrentValue", "Default"}, minimum)) or minimum
    default = math.clamp(default, minimum, maximum)
    local height = description ~= "" and 84 or 62

    local container = create("Frame", {
        Name = "Slider",
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = self:_nextOrder(),
    }, self.Parent)
    styleSurface(container, THEME.ButtonAlt)
    local titleLabel, descriptionLabel, iconLabel = createElementHeader(container, options, 76, height - 12)

    local valueLabel = create("TextLabel", {
        Name = "Value",
