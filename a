local function mirrorValueFields(element, value)
    element.value = value
    element.Value = value
    element.CurrentValue = value
    if element.Type == "Dropdown" then
        element.CurrentOption = value
    elseif element.Type == "Keybind" then
        element.CurrentKeybind = value
    elseif element.Type == "ColorPicker" then
        element.Color = value
    end
end

local function registerElement(section, element, searchableObject)
    local window = section.Window
    element.Window = window
    element.Section = section
    element.Tab = section.Tab
    element.Object = element.Object or searchableObject
    element.Title = element.Title or element.name or ""
    element.SourceTitle = element.SourceTitle or element.Title
    element.Name = element.Title
    element.name = element.Title
    element.Description = element.Description or element.description or ""
    element.SourceDescription = element.SourceDescription or element.Description
    element.description = element.Description
    element.Visible = true

    if type(element._refreshLocalizedText) ~= "function" then
        function element:_refreshLocalizedText()
            local translatedTitle = self.Window:_translate(self.SourceTitle or self.Title or "")
            local translatedDescription = self.Window:_translate(self.SourceDescription or self.Description or "")
            if self.TitleLabel then
                self.TitleLabel.Text = translatedTitle
            elseif self.Object and self.Object:IsA("TextButton") then
                self.Object.Text = translatedTitle
            end
            if self.DescriptionLabel then
                self.DescriptionLabel.Text = translatedDescription
                self.DescriptionLabel.Visible = (self.SourceDescription or "") ~= ""
            end
        end
    end
    element.ForgetState = element.ForgetState == true or element.forgetState == true
    element.forgetState = element.ForgetState

    if element.Stateful and not element.ForgetState then
        local requestedFlag = element.Flag or element.flag
        element.Flag = window:_uniqueFlag(requestedFlag or deriveFlagFromName(element.Title), element)
        element.flag = element.Flag
    else
        element.Flag = element.Flag or element.flag
        element.flag = element.Flag
    end

    window._elements[element] = true
    section.Elements = section.Elements or {}
    section.Elements[#section.Elements + 1] = element

    if searchableObject then
        searchableObject:SetAttribute("VanillaUISearchable", true)
    end
    window:_refreshElementSearchText(element)

    if element.Stateful then
        mirrorValueFields(element, element.value ~= nil and element.value or element.Value)
    end

    if element.Flag then
        window._flagElements[element.Flag] = element
        window.Flags[element.Flag] = element.value
        VanillaUI.Flags[element.Flag] = element.value
        if window._loadedValues[element.Flag] ~= nil and type(element.Set) == "function" then
            local restored = deserializeValue(window._loadedValues[element.Flag])
            task.defer(function()
                if not window.Destroyed and element.Object and element.Object.Parent then
                    element:Set(restored, false, true)
                end
            end)
        end
    end

    if type(section._refreshGroupSize) == "function" then
        task.defer(section._refreshGroupSize, section)
    end
    if type(element._refreshLocalizedText) == "function" then
        element:_refreshLocalizedText()
    end
    if type(window._refreshSearchResults) == "function" then
        task.defer(window._refreshSearchResults)
    end

    return element
end

local function updateFlag(element, value, skipSave)
    mirrorValueFields(element, value)
    if element.Flag then
        element.Window.Flags[element.Flag] = value
        VanillaUI.Flags[element.Flag] = value
    end
    if not skipSave and not element.ForgetState then
        element.Window:_scheduleSave()
    end
end

local function styleButton(window, button, isActiveProvider)
    button.AutoButtonColor = false
    button.Font = Enum.Font.Gotham
    button.TextSize = 12
    button.TextWrapped = true
    button.TextScaled = false
    button.TextColor3 = THEME.Text
    styleSurface(button, THEME.Button)

    local stroke = button:FindFirstChildOfClass("UIStroke")

    local function refresh(hovered)
        local active = type(isActiveProvider) == "function" and isActiveProvider() == true
        local background = active and THEME.Accent or (hovered and THEME.Hover or THEME.Button)
        local textColor = active and Color3.fromRGB(20, 19, 17) or (hovered and THEME.SubText or THEME.Text)
        local transparency = active and STYLE.AcrylicActive or (hovered and STYLE.AcrylicHover or STYLE.Acrylic)
        local strokeTransparency = active and STYLE.StrokeActive or (hovered and STYLE.StrokeHover or STYLE.Stroke)

        tween(button, {
            BackgroundColor3 = background,
            BackgroundTransparency = transparency,
            TextColor3 = textColor,
        })

        if stroke then
            tween(stroke, {
                Transparency = strokeTransparency,
                Thickness = hovered and 1.25 or 1,
            })
        end
    end

    registerConnection(window, button.MouseEnter:Connect(function()
        if not button:GetAttribute("VanillaUILocked") then
            refresh(true)
        end
    end))

    registerConnection(window, button.MouseLeave:Connect(function()
        if not button:GetAttribute("VanillaUILocked") then
            refresh(false)
        end
    end))

    refresh(false)
    return refresh
end

