        Text = title,
        TextColor3 = THEME.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
    }, notification)

    create("TextLabel", {
        Name = "Content",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = content,
        TextColor3 = THEME.SubText,
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 2,
    }, notification)

    notification.Position = UDim2.fromOffset(18, 0)
    notification.BackgroundTransparency = 1
    task.defer(function()
        if notification.Parent then
            tween(notification, {
                Position = UDim2.fromOffset(0, 0),
                BackgroundTransparency = STYLE.Acrylic,
            })
        end
    end)

    task.delay(duration, function()
        if notification.Parent then
            tween(notification, {
                Position = UDim2.fromOffset(18, 0),
                BackgroundTransparency = 1,
            })
            task.delay(0.18, function()
                destroy(notification)
            end)
        end
    end)

    return notification
end

function WindowMethods:Destroy()
    if self.Destroyed then
        return
    end
    self.Destroyed = true

    for _, callback in ipairs(self._cleanupCallbacks) do
        safeCall(callback)
    end

    for _, connection in ipairs(self._connections) do
        disconnect(connection)
    end

    destroy(self.ScreenGui)

    if GLOBAL_ENV[CLEANUP_KEY] == self._cleanupFunction then
        GLOBAL_ENV[CLEANUP_KEY] = nil
    end
end

