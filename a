function VanillaUI:PlayIntro(options)
    options = type(options) == "table" and options or {}
    if option(options, {"enabled", "Enabled"}, true) == false then
        return {Skipped = true}
    end

    local title = tostring(option(options, {"title", "Title"}, "VANILLA"))
    local subtitle = tostring(option(options, {"subtitle", "Subtitle"}, "Initializing interface"))
    local duration = math.clamp(tonumber(option(options, {"duration", "Duration"}, 1.4)) or 1.4, 0.8, 4)
    local skipAfterFirstRun = option(options, {"skipAfterFirstRun", "SkipAfterFirstRun"}, false) == true
    local markerName = sanitizeFileName(option(options, {"key", "Key", "id", "Id"}, title))
    local markerKey = "__VANILLA_UI_INTRO_" .. markerName
    local markerPath = "VanillaUI/.intro_" .. markerName .. ".txt"

    if skipAfterFirstRun then
        if GLOBAL_ENV[markerKey] == true then
            return {Skipped = true}
        end
        local found = false
        pcall(function()
            found = type(isfile) == "function" and isfile(markerPath)
        end)
        if found then
            GLOBAL_ENV[markerKey] = true
            return {Skipped = true}
        end
    end

    local locale = normalizeLocaleId(option(options, {"locale", "Locale"}, LocalPlayer and LocalPlayer.LocaleId or "en"))
    local packs = copyTranslationPacks(option(options, {"translations", "Translations"}, {}))
    local translator = option(options, {"translator", "Translator"}, nil)
    local function translate(source)
        if type(translator) == "function" then
            local ok, value = safeCall(translator, source, locale)
            if ok and value ~= nil then
                return tostring(value)
            end
        end
        local exact = packs[locale]
        if exact and exact[source] ~= nil then
            return tostring(exact[source])
        end
        local base = locale:match("^([^-]+)")
        if base and packs[base] and packs[base][source] ~= nil then
            return tostring(packs[base][source])
        end
        return source
    end

    local stages = option(options, {"stages", "Stages"}, nil)
    if type(stages) ~= "table" or #stages == 0 then
        stages = {"Loading interface", "Applying profile", "Restoring configuration", "Ready"}
    end

    local introGui = create("ScreenGui", {
        Name = "VanillaUI_Intro_" .. markerName,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = tonumber(option(options, {"displayOrder", "DisplayOrder"}, 500)) or 500,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, resolveGuiParent())

    local overlay = create("Frame", {
        Name = "Overlay",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(6, 6, 6),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 1,
    }, introGui)

    local card = create("Frame", {
        Name = "Card",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(360, 142),
        BackgroundColor3 = THEME.Background,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, overlay)
    addCorner(card, STYLE.MainCorner)
    local cardStroke = addStroke(card, THEME.Border, 1)

    local titleLabel = create("TextLabel", {
        Position = UDim2.fromOffset(20, 18),
        Size = UDim2.new(1, -40, 0, 26),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = title,
        TextColor3 = THEME.CategoryTitle,
        TextTransparency = 1,
        TextSize = 20,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, card)
    local subtitleLabel = create("TextLabel", {
        Position = UDim2.fromOffset(20, 46),
        Size = UDim2.new(1, -40, 0, 20),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = subtitle,
        TextColor3 = THEME.SubText,
        TextTransparency = 1,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, card)
    local stageLabel = create("TextLabel", {
        Position = UDim2.fromOffset(20, 82),
        Size = UDim2.new(1, -40, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = "",
        TextColor3 = THEME.Text,
        TextTransparency = 1,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, card)
    local track = create("Frame", {
        Position = UDim2.new(0, 20, 1, -24),
        Size = UDim2.new(1, -40, 0, 4),
        BackgroundColor3 = Color3.fromRGB(40, 37, 32),
        BorderSizePixel = 0,
        ZIndex = 3,
    }, card)
    addCorner(track, 2)
    local fill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = THEME.Accent,
        BorderSizePixel = 0,
        ZIndex = 4,
    }, track)
    addCorner(fill, 2)

    TweenService:Create(overlay, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0.18}):Play()
    TweenService:Create(card, STYLE.TweenPanel, {BackgroundTransparency = 0.04, Size = UDim2.fromOffset(360, 150)}):Play()
    TweenService:Create(cardStroke, STYLE.TweenPanel, {Transparency = STYLE.Stroke}):Play()
    TweenService:Create(titleLabel, STYLE.TweenPanel, {TextTransparency = 0}):Play()
    TweenService:Create(subtitleLabel, STYLE.TweenPanel, {TextTransparency = 0}):Play()
    TweenService:Create(stageLabel, STYLE.TweenPanel, {TextTransparency = 0}):Play()

    local stageDuration = duration / #stages
    for index, source in ipairs(stages) do
        stageLabel.Text = translate(tostring(source))
        local progressTween = TweenService:Create(fill, TweenInfo.new(stageDuration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(index / #stages, 0, 1, 0),
        })
        progressTween:Play()
        safeCall(option(options, {"onStep", "OnStep"}, nil), index, source)
        task.wait(stageDuration)
    end

    TweenService:Create(card, STYLE.TweenPanel, {BackgroundTransparency = 1, Size = UDim2.fromOffset(344, 136)}):Play()
    TweenService:Create(cardStroke, STYLE.TweenPanel, {Transparency = 1}):Play()
    TweenService:Create(titleLabel, STYLE.TweenPanel, {TextTransparency = 1}):Play()
    TweenService:Create(subtitleLabel, STYLE.TweenPanel, {TextTransparency = 1}):Play()
    TweenService:Create(stageLabel, STYLE.TweenPanel, {TextTransparency = 1}):Play()
    TweenService:Create(overlay, STYLE.TweenPanel, {BackgroundTransparency = 1}):Play()
    task.wait(STYLE.TweenPanel.Time)
    destroy(introGui)

    if skipAfterFirstRun then
        GLOBAL_ENV[markerKey] = true
        pcall(function()
            if type(makefolder) == "function" and (type(isfolder) ~= "function" or not isfolder("VanillaUI")) then
                makefolder("VanillaUI")
            end
            if type(writefile) == "function" then
                writefile(markerPath, "shown")
            end
        end)
    end

    return {Skipped = false, Completed = true}
end

