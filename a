        self.TextLabel.Text = self.Text or ""
        self.TextLabel.Visible = self.Text ~= nil and self.Text ~= ""
    end
    return self
end

function TagMethods:SetIcon(icon)
    self.Icon = icon
    local resolved = resolveIcon(icon)
    if self.IconLabel then
        self.IconLabel.Image = resolved or ""
        self.IconLabel.Visible = resolved ~= nil
    end
    return self
