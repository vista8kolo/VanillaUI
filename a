    end

    local choicesY = headerHeight + (searchable and 40 or 5)
    local choices = create("ScrollingFrame", {
        Name = "Choices",
        Position = UDim2.fromOffset(0, choicesY),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = THEME.Accent,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        Visible = false,
        ZIndex = 4,
    }, root)
    local choicesLayout = create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, choices)

    local element = setmetatable({
        Type = "Dropdown",
        Stateful = true,
        Title = title,
        Description = description,
        Object = root,
        Button = button,
        TitleLabel = titleLabel,
        DescriptionLabel = descriptionLabel,
        IconLabel = iconLabel,
        ValueLabel = valueLabel,
        Choices = choices,
        SearchBox = searchBox,
        Values = {},
        OptionButtons = {},
        Multiple = multiple,
        Searchable = searchable,
        HeaderHeight = headerHeight,
        ChoicesY = choicesY,
        Open = false,
        Flag = option(options, {"flag", "Flag"}, nil),
        ForgetState = option(options, {"forgetState", "ForgetState"}, false) == true,
        value = {},
        DefaultValue = normalizeDropdownSelection(initial),
        Callback = option(options, {"callback", "Callback"}, nil),
    }, ElementMethods)

    local refreshStyle = styleInteractiveSurface(self.Window, button, button, function()
        return element.Open
    end, {titleLabel})

    function element:_selected(optionValue)
        return table.find(self.value, tostring(optionValue)) ~= nil
    end

    function element:_callbackValue()
        return table.clone(self.value)
    end

    function element:_updateSelectedLabel()
        if #self.value == 0 then
            self.ValueLabel.Text = "Ninguno"
        elseif not self.Multiple then
            self.ValueLabel.Text = tostring(self.value[1])
        elseif #self.value <= 2 then
            self.ValueLabel.Text = table.concat(self.value, ", ")
        else
            self.ValueLabel.Text = tostring(self.value[1]) .. " +" .. tostring(#self.value - 1)
        end
    end

    function element:_refreshOptionStyles()
        for optionValue, entry in pairs(self.OptionButtons) do
            entry.Refresh()
            entry.Check.Text = self:_selected(optionValue) and "✓" or ""
        end
    end

    function element:_refreshVisual()
        self:_updateSelectedLabel()
        self:_refreshOptionStyles()
        refreshStyle()
    end

    function element:Set(value, skipCallback, skipSave)
        local requested = normalizeDropdownSelection(value)
        local selected = {}
        for _, item in ipairs(requested) do
            if table.find(self.Values, item) and not table.find(selected, item) then
                selected[#selected + 1] = item
                if not self.Multiple then
                    break
                end
            end
        end
        local before = table.concat(self.value, "\0")
        local after = table.concat(selected, "\0")
        updateFlag(self, selected, skipSave)
        self:_refreshVisual()
        if before ~= after and not skipCallback then
            safeCall(self.Callback, self:_callbackValue())
        end
        return self
    end

    function element:SetOpen(open)
        self.Open = open == true
        self.Choices.Visible = self.Open
        if self.SearchBox then
            self.SearchBox.Visible = self.Open
        end
        local visibleCount = 0
        for _, entry in pairs(self.OptionButtons) do
            if entry.Button.Visible then
                visibleCount = visibleCount + 1
            end
        end
        local contentHeight = math.min(180, math.max(0, visibleCount * 30 + math.max(0, visibleCount - 1) * 4))
        self.Choices.Size = UDim2.new(1, 0, 0, contentHeight)
        local target = self.HeaderHeight
        if self.Open then
            target = self.ChoicesY + contentHeight
        end
        tween(self.Object, {Size = UDim2.new(1, 0, 0, target)})
        refreshStyle()
        return self
    end

    function element:_applyFilter(query)
        query = normalizeSearchText(query)
        for optionValue, entry in pairs(self.OptionButtons) do
            entry.Button.Visible = query == "" or normalizeSearchText(optionValue):find(query, 1, true) ~= nil
        end
        if self.Open then
            self:SetOpen(true)
        end
    end

    function element:RefreshOptions(newValues, keepSelection)
        self.Values = {}
        for _, value in ipairs(newValues or {}) do
            local text = tostring(value)
            if not table.find(self.Values, text) then
                self.Values[#self.Values + 1] = text
            end
        end
        for _, entry in pairs(self.OptionButtons) do
            destroy(entry.Button)
        end
        table.clear(self.OptionButtons)

        for index, optionValue in ipairs(self.Values) do
            local optionButton = create("TextButton", {
                Name = "Option",
                Size = UDim2.new(1, -2, 0, 30),
                LayoutOrder = index,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 5,
            }, self.Choices)
            local label = create("TextLabel", {
                Position = UDim2.fromOffset(10, 0),
                Size = UDim2.new(1, -42, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = optionValue,
                TextColor3 = THEME.Text,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 6,
            }, optionButton)
            local check = create("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 0),
                Size = UDim2.fromOffset(20, 30),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = "",
                TextColor3 = Color3.fromRGB(20, 19, 17),
                TextSize = 12,
                ZIndex = 6,
            }, optionButton)
            local refresh = styleInteractiveSurface(self.Window, optionButton, optionButton, function()
                return element:_selected(optionValue)
            end, {label})
            self.OptionButtons[optionValue] = {Button = optionButton, Label = label, Check = check, Refresh = refresh}
            registerConnection(self.Window, optionButton.MouseButton1Click:Connect(function()
                if self.Multiple then
                    local selected = table.clone(self.value)
                    local found = table.find(selected, optionValue)
                    if found then
                        table.remove(selected, found)
                    else
                        selected[#selected + 1] = optionValue
                    end
                    self:Set(selected)
                else
                    self:Set({optionValue})
                    self:SetOpen(false)
                end
            end))
        end

        if not keepSelection then
            self:Set({}, true)
        else
            self:Set(self.value, true)
        end
        self:_applyFilter(self.SearchBox and self.SearchBox.Text or "")
        return self
    end

    element.Refresh = element.RefreshOptions

    function element:Add(value)
        local valuesCopy = table.clone(self.Values)
        local text = tostring(value)
        if not table.find(valuesCopy, text) then
            valuesCopy[#valuesCopy + 1] = text
            self:RefreshOptions(valuesCopy, true)
        end
        return self
    end

    function element:Remove(value)
        local valuesCopy = table.clone(self.Values)
        local index = table.find(valuesCopy, tostring(value))
        if index then
            table.remove(valuesCopy, index)
            self:RefreshOptions(valuesCopy, true)
        end
        return self
    end

    registerConnection(self.Window, button.MouseButton1Click:Connect(function()
        if element.Locked then
            self.Window:Notify({Title = "Control bloqueado", Content = element.LockReason or title, Duration = 3})
            return
        end
        element:SetOpen(not element.Open)
    end))
    if searchBox then
        registerConnection(self.Window, searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            element:_applyFilter(searchBox.Text)
        end))
    end

    registerElement(self, element, root)
    element:RefreshOptions(values, true)
    element:Set(initial, true, true)
    return element
end

