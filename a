    if type(introOptions) == "table" and option(introOptions, {"enabled", "Enabled"}, true) ~= false then
        introOptions.Title = introOptions.Title or option(options, {"title", "Title", "name", "Name"}, "VANILLA")
        introOptions.Subtitle = introOptions.Subtitle or option(options, {"subtitle", "Subtitle", "LoadingSubtitle"}, "Vanilla Lattice")
