function WindowMethods:LogActivity(options)
    options = type(options) == "table" and options or {Content = tostring(options)}
    self._activityOrder = (self._activityOrder or 0) + 1
    local entry = {
        Id = HttpService:GenerateGUID(false),
        Title = tostring(option(options, {"title", "Title"}, "VanillaUI")),
        Content = tostring(option(options, {"content", "Content", "description", "Description"}, "")),
        State = tostring(option(options, {"state", "State", "type", "Type"}, "Information")),
        Timestamp = os.time(),
        Clock = os.date("%H:%M:%S"),
        Order = self._activityOrder,
    }
    self.Activities = self.Activities or {}
    table.insert(self.Activities, 1, entry)
    while #self.Activities > (self.ActivityLimit or ACTIVITY_LIMIT) do
        local removed = table.remove(self.Activities)
        if removed and removed.Object then
            destroy(removed.Object)
        end
    end
    if type(self._renderActivity) == "function" then
        self:_renderActivity(entry)
    end
    local immersive = self._immersive
    if not (immersive and immersive.ActivityHistoryExpanded) then
        self.UnreadActivities = (self.UnreadActivities or 0) + 1
    end
    if type(self._refreshActivityBadge) == "function" then
        self:_refreshActivityBadge()
    end
    return entry
end

function WindowMethods:GetActivities()
    local output = {}
    for index, entry in ipairs(self.Activities or {}) do
